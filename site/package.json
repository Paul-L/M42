{
  "name": "m42-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verif": "npm run build && npm run lint && npm run format:check && node scripts/verif.mjs",
    "visuel": "node tests/visual/toutes.mjs",
    "cms:schema": "tsx ../cms/scripts/schema.ts",
    "cms:roles": "tsx ../cms/scripts/roles.ts",
    "cms:seed": "tsx ../cms/scripts/seed.ts",
    "cms:flows": "tsx ../cms/scripts/flows.ts",
    "test:formulaires": "node tests/e2e/formulaires.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@directus/sdk": "27.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "13.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
