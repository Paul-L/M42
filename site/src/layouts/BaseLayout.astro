---
/**
 * Gabarit de page : <head>, lien d'évitement, en-tête, contenu, pied de page.
 * Polices auto-hébergées (Fontsource) : aucune ressource tierce chargée par le navigateur.
 */
import '@fontsource/cormorant/500.css';
import '@fontsource/cormorant/600.css';
import '@fontsource/cormorant/500-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavKey } from '../data/navigation';
import { frenchTypography } from '../lib/typo';

interface Props {
  title: string;
  description?: string;
  /** Lien d'en-tête à marquer comme page courante. */
  current?: NavKey;
  /** Rubrique d'en-tête parente (aria-current="true"), voir DECISIONS.md point 3. */
  section?: NavKey;
  /** Page à exclure des moteurs (page interne, préproduction). */
  noindex?: boolean;
  /** Marque le lien de cette page dans le pied de page (pages légales, Contact, À propos, Organisateurs). */
  footerCurrent?: boolean;
  /** Données structurées (schema.org), sérialisées en JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  current,
  section,
  noindex = false,
  jsonLd,
  footerCurrent = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta name="theme-color" content="#F2EEE6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd, (_k, v: unknown) =>
          typeof v === 'string' ? frenchTypography(v) : v,
        ).replace(/</g, '\\u003c')}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#contenu" class="skip">
      Aller au contenu
    </a>
    <Header current={current} section={section} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer current={footerCurrent ? Astro.url.pathname : undefined} />
  </body>
</html>

<style>
  /* Lien d'évitement (toujours en premier) */
  .skip {
    position: absolute;
    left: 16px;
    top: -200px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    box-sizing: border-box;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 18px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }
</style>
