---
/**
 * Gabarit de page : <head>, lien d'évitement, en-tête, contenu, pied de page.
 * Polices auto-hébergées (Fontsource) : aucune ressource tierce chargée par le navigateur.
 */
import '@fontsource/cormorant/500.css';
import '@fontsource/cormorant/600.css';
import '@fontsource/cormorant/500-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
// Polices présentes sur toutes les pages (texte, titres) : préchargées.
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import cormorantUrl from '@fontsource/cormorant/files/cormorant-latin-600-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavKey } from '../data/navigation';
import { frenchTypography } from '../lib/typo';

interface Props {
  title: string;
  description?: string;
  /** Lien d'en-tête à marquer comme page courante. */
  current?: NavKey;
  /** Rubrique d'en-tête parente (aria-current="true"), voir DECISIONS.md point 3. */
  section?: NavKey;
  /** Page à exclure des moteurs (page interne, préproduction). */
  noindex?: boolean;
  /** Marque le lien de cette page dans le pied de page (pages légales, Contact, À propos, Organisateurs). */
  footerCurrent?: boolean;
  /** Données structurées (schema.org), sérialisées en JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Type Open Graph (défaut « website » ; « article » pour un guide). */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  current,
  section,
  noindex = false,
  jsonLd,
  footerCurrent = false,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Préproduction (M42_ENV=preprod) : aucune page indexable (en plus de l'en-tête X-Robots-Tag
// et du mot de passe posés par le serveur, phase 5).
const preprod = (import.meta.env.M42_ENV ?? process.env.M42_ENV) === 'preprod';
const indexable = !noindex && !preprod;
const ogImage = new URL('/og-m42.png', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {indexable ? (
      <link rel="canonical" href={canonical} />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="M42" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="M42.guide : se repérer dans l'IA." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F2EEE6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd, (_k, v: unknown) =>
          typeof v === 'string' ? frenchTypography(v) : v,
        ).replace(/</g, '\\u003c')}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#contenu" class="skip">
      Aller au contenu
    </a>
    <Header current={current} section={section} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer current={footerCurrent ? Astro.url.pathname : undefined} />
  </body>
</html>

<style>
  /* Lien d'évitement (toujours en premier) */
  .skip {
    position: absolute;
    left: 16px;
    top: -200px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    box-sizing: border-box;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 18px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }
</style>
