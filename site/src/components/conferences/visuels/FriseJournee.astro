---
/**
 * Frise de la journée (conférence IV « Parents, ados et IA »), à placer dans le slot « before »
 * de ScrollStory. Aucun JavaScript : le repère or et les couleurs des heures suivent les attributs
 * data-mode / data-step posés par ScrollStory sur la section.
 *
 * Correspondance avec renderVals() de la maquette (6 étapes) :
 * - repère : left = (étape + 0,5) / 6 × 100 % (8,33 %, 25 %, 41,67 %, 58,33 %, 75 %, 91,67 %),
 *   glissement 320 ms ease-in-out ;
 * - heures : or pour l'étape courante, #CFC8BB pour les étapes passées, #9A9488 ensuite.
 * En mode à plat, l'étape est la dernière (comme dans la maquette).
 * Décorative (aria-hidden) : les heures sont reprises dans les sur-titres des étapes.
 *
 * Props :
 * - heures : libellés des six étapes (« 7 h 10 » … « La charte »).
 */
interface Props {
  heures: string[];
}

const { heures } = Astro.props;
---

<div class="frise" aria-hidden="true">
  <div class="line"></div>
  <div class="mark"></div>
  <div class="times">
    {heures.map((h) => (
      <span class="t">{h}</span>
    ))}
  </div>
</div>

<style>
  .frise {
    position: relative;
    margin-top: 24px;
  }

  .line {
    position: absolute;
    left: 8.33%;
    right: 8.33%;
    top: 9px;
    height: 1px;
    background: var(--night-line);
  }

  .mark {
    position: absolute;
    left: 8.33%;
    top: 3px;
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 7px;
    background: var(--gold);
    transition: left var(--dur-3) var(--ease-in-out);
  }

  :global([data-story][data-step='1']) .mark {
    left: 25%;
  }

  :global([data-story][data-step='2']) .mark {
    left: 41.67%;
  }

  :global([data-story][data-step='3']) .mark {
    left: 58.33%;
  }

  :global([data-story][data-step='4']) .mark {
    left: 75%;
  }

  :global([data-story][data-step='5']) .mark {
    left: 91.67%;
  }

  .times {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    padding-top: 26px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .times {
      font-size: 10px;
    }
  }

  .t {
    color: var(--on-night-3);
    transition: color var(--dur-3) var(--ease-out);
  }

  /* Heures passées */
  :global([data-story][data-step='1']) .t:nth-child(-n + 1),
  :global([data-story][data-step='2']) .t:nth-child(-n + 2),
  :global([data-story][data-step='3']) .t:nth-child(-n + 3),
  :global([data-story][data-step='4']) .t:nth-child(-n + 4),
  :global([data-story][data-step='5']) .t:nth-child(-n + 5) {
    color: var(--on-night-2);
  }

  /* Heure courante */
  :global([data-story][data-step='0']) .t:nth-child(1),
  :global([data-story][data-step='1']) .t:nth-child(2),
  :global([data-story][data-step='2']) .t:nth-child(3),
  :global([data-story][data-step='3']) .t:nth-child(4),
  :global([data-story][data-step='4']) .t:nth-child(5),
  :global([data-story][data-step='5']) .t:nth-child(6) {
    color: var(--gold-night);
  }
</style>
