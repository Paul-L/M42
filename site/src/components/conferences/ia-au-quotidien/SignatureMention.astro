---
/**
 * Mention « Conférence signature » avec l'étoile d'or, au-dessus du H1 de la conférence I
 * (slot « before-title » de ConferenceHero). Seule étoile d'or des pages Conférences.
 */
interface Props {
  label?: string;
}

const { label = 'Conférence signature' } = Astro.props;
---

<p class="sig">
  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M12 1 C13 10 14 11 23 12 C14 13 13 14 12 23 C11 14 10 13 1 12 C10 11 11 10 12 1 Z"
      fill="currentColor"
    ></path>
  </svg>
  {label}
</p>

<style>
  .sig {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .sig svg {
    flex: none;
    color: var(--gold);
  }
</style>
