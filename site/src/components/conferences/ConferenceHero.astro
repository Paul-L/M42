---
/**
 * En-tête d'une page conférence (kit/maquette/Conf-*.dc.html, section « titre-page »).
 * Fil d'Ariane, H1 (sur-titre + titre), sous-titre en italique, promesse, deux boutons,
 * signature « Par Clara Peron et Paul Loustaunau · Mise à jour », fiche à droite (dl).
 * Aucune animation d'entrée (au-dessus de la ligne de flottaison).
 *
 * Props :
 * - titre : titre du H1 (et dernier élément du fil d'Ariane).
 * - surTitre : sur-titre placé dans le H1 (« Conférence II · … »).
 * - noteTitre : note éditoriale sous le H1, en encadré pointillé (marqueur [À DÉCIDER]…).
 * - sousTitre : phrase en italique (Cormorant).
 * - promesse : chapô (ce que l'on emporte).
 * - ctaPrincipal : bouton primaire (défaut : « Programmer cette conférence » → /contact/).
 * - ctaSecondaire : bouton secondaire (ancre vers la démonstration ou le jeu).
 * - miseAJour : date affichée après la signature.
 * - fiche : lignes de la fiche (Pour qui, Formats, Participants, Où).
 * - subtitleMax : largeur maximale du sous-titre en ch (26 par défaut, conférence II ;
 *   28 dans les maquettes des conférences I, III et IV).
 *
 * Slots :
 * - before-title : au-dessus du H1 (ex. « Conférence signature » avec l'étoile, conférence I).
 * - after-actions : sous les boutons (ex. mention « Strictement neutre », conférence III).
 */
import Breadcrumb from '../Breadcrumb.astro';
import Button from '../Button.astro';
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import { routes } from '../../data/routes';
import type { Lien, LigneFiche } from '../../data/conferences/types';

interface Props {
  titre: string;
  surTitre: string;
  noteTitre?: string | undefined;
  sousTitre: string;
  promesse: string;
  ctaPrincipal?: Lien;
  ctaSecondaire: Lien;
  miseAJour: string;
  fiche: LigneFiche[];
  subtitleMax?: 26 | 28;
}

const {
  titre,
  surTitre,
  noteTitre,
  sousTitre,
  promesse,
  ctaPrincipal = { label: 'Programmer cette conférence', href: routes['Contact.dc.html'] },
  ctaSecondaire,
  miseAJour,
  fiche,
  subtitleMax = 26,
} = Astro.props;
---

<section aria-labelledby="titre-page" class="hero">
  <Container>
    <Breadcrumb
      items={[
        { label: 'Accueil', href: routes['Main.dc.html'] },
        { label: 'Conférences', href: routes['Conferences.dc.html'] },
        { label: titre },
      ]}
    />
    <div class="row">
      <div class="main">
        <slot name="before-title" />
        <h1 id="titre-page" class="h1">
          <Eyebrow as="span" rule={false}>
            {surTitre}
          </Eyebrow>
          <span class="h1-title">{titre}</span>
        </h1>
        {noteTitre && <p class="note">{noteTitre}</p>}
        <p class:list={['subtitle', { 'subtitle--28': subtitleMax === 28 }]}>{sousTitre}</p>
        <p class="promise">{promesse}</p>
        <div class="actions">
          <Button href={ctaPrincipal.href}>{ctaPrincipal.label}</Button>
          <Button href={ctaSecondaire.href} variant="secondary">
            {ctaSecondaire.label}
          </Button>
        </div>
        <slot name="after-actions" />
        <p class="byline">
          Par <a href={routes['A-propos.dc.html']}>Clara Peron et Paul Loustaunau</a> · Mise à jour
          : {miseAJour}
        </p>
      </div>
      <dl class="fiche">
        {fiche.map((ligne) => (
          <div class="fiche-row">
            <dt>{ligne.label}</dt>
            <dd>{ligne.valeur}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 4vw, 3.5rem) 0 clamp(4rem, 7vw, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 48px 64px;
  }

  .main {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-weight: 400;
  }

  .h1-title {
    max-width: var(--measure-h1);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tracking-h1);
    color: var(--ink);
  }

  .note {
    margin: 0;
    align-self: flex-start;
    padding: 6px 10px;
    border: 1px dashed var(--line-strong);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .subtitle {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-quote);
    line-height: var(--lh-quote);
    color: var(--ink-2);
  }

  .subtitle--28 {
    max-width: 28ch;
  }

  .promise {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .byline {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .byline a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }

  .fiche {
    flex: 1 1 300px;
    min-width: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .fiche-row {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  dd {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.5;
  }
</style>
