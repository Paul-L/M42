---
/**
 * Carte de la conférence signature (I) dans « Les autres conférences » : identique à la carte
 * partagée ConferenceCard, avec l'étoile d'or et la mention « Conférence signature » à côté
 * du chiffre romain. ConferenceCard n'a pas encore d'option pour ce badge (à consolider).
 *
 * Props : celles de ConferenceCard (numeral, title, href, summary, publics, formats, cta,
 * headingLevel, reveal) + badge (défaut « Conférence signature »).
 */
import AudienceTag from '../AudienceTag.astro';

interface Props {
  numeral: string;
  title: string;
  href: string;
  summary: string;
  publics?: string[];
  formats?: string[];
  cta?: string;
  headingLevel?: 'h2' | 'h3';
  reveal?: boolean;
  badge?: string;
}

const {
  numeral,
  title,
  href,
  summary,
  publics = [],
  formats = [],
  cta = 'Voir la conférence',
  headingLevel: Heading = 'h3',
  reveal = true,
  badge = 'Conférence signature',
} = Astro.props;
---

<article class:list={['card', { 'm42-reveal': reveal }]}>
  <div class="top">
    <span class="sig">
      <span aria-hidden="true" class="numeral">
        {numeral}
      </span>
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 1 C13 10 14 11 23 12 C14 13 13 14 12 23 C11 14 10 13 1 12 C10 11 11 10 12 1 Z"
          fill="currentColor"
        ></path>
      </svg>
      <span class="badge">{badge}</span>
    </span>
    {publics.length > 0 && (
      <ul aria-label="Publics" class="publics">
        {publics.map((p) => (
          <AudienceTag as="li">{p}</AudienceTag>
        ))}
      </ul>
    )}
  </div>
  <Heading class="card-title">
    <a href={href} class="stretch">
      {title}
    </a>
  </Heading>
  <p class="summary">{summary}</p>
  {formats.length > 0 && <p class="formats">{formats.join(' · ')}</p>}
  <span class="cta" aria-hidden="true">
    {cta} <span class="arrow-i">→</span>
  </span>
  <span class="bar" aria-hidden="true"></span>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .card:hover {
    border-color: var(--ink);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .sig {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .sig svg {
    color: var(--gold);
  }

  .numeral {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 28px;
    line-height: 1;
    color: var(--gold-deep);
  }

  .badge {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .publics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .card-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-card);
    line-height: var(--lh-card);
  }

  .stretch {
    color: var(--ink);
    text-decoration: none;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .stretch:focus-visible {
    outline: none;
  }

  .stretch:focus-visible::after {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .summary {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .formats {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .cta {
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .card:hover .cta {
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
  }

  .arrow-i {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .card:hover .arrow-i {
    transform: translateX(3px);
  }

  .bar {
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -1px;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .card:hover .bar,
  .card:focus-within .bar {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .arrow-i {
      transform: none;
    }
  }
</style>
