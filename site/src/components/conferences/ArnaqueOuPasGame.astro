---
/**
 * Jeu « Arnaque ou pas ? » (conférence II, temps fort) : un message à la fois, deux boutons
 * « Arnaque » / « Fiable », verdict et explication annoncés (aria-live), score au dernier message,
 * puis « Recommencer ». Logique de la maquette (renderVals, objet `q`) ; moteur partagé : ./quiz.ts.
 *
 * Rendu serveur : premier message (état initial de la maquette). Les textes des messages sont
 * passés à l'îlot en JSON, typographie française déjà appliquée.
 * Clavier : après une réponse, le focus va sur « Message suivant » ; après « Message suivant »
 * ou « Recommencer », il revient sur le texte du message (les boutons de réponse ayant été masqués).
 *
 * Props :
 * - messages : { de, texte, arnaque, explication }[].
 * - labels : libellés (facultatif) ; {n}, {total} et {score} sont remplacés.
 * - reveal : apparition au défilement (défaut : true).
 */
import Button from '../Button.astro';
import { frenchTypography } from '../../lib/typo';
import type { MessageJeu } from '../../data/conferences/types';

export interface GameLabels {
  counter: string;
  scam: string;
  legit: string;
  right: string;
  wrong: string;
  verdictScam: string;
  verdictLegit: string;
  score: string;
  next: string;
  restart: string;
}

interface Props {
  messages: MessageJeu[];
  labels?: Partial<GameLabels>;
  reveal?: boolean;
}

const DEFAULT_LABELS: GameLabels = {
  counter: 'Message {n} sur {total}',
  scam: 'Arnaque',
  legit: 'Fiable',
  right: 'Bien vu. ',
  wrong: 'Raté. ',
  verdictScam: "C'est une arnaque.",
  verdictLegit: 'Ce message est fiable.',
  score:
    'Votre score : {score} sur {total}. En conférence, la salle vote à main levée, puis on décortique chaque indice.',
  next: 'Message suivant →',
  restart: 'Recommencer',
};

const { messages, labels: custom = {}, reveal = true } = Astro.props;
const labels: GameLabels = { ...DEFAULT_LABELS, ...custom };
const first = messages[0];
const total = messages.length;

const typo = (s: string): string => frenchTypography(s);
const data = {
  messages: messages.map((m) => ({
    de: typo(m.de),
    texte: typo(m.texte),
    arnaque: m.arnaque,
    explication: typo(m.explication),
  })),
  labels: Object.fromEntries(Object.entries(labels).map(([key, v]) => [key, typo(v)])),
};
// Pas de « < » brut dans le bloc JSON (aucune fermeture de balise possible).
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const fill = (tpl: string, values: Record<string, number>): string =>
  tpl.replace(/\{(\w+)\}/g, (_m, key: string) => String(values[key] ?? ''));
---

<div class:list={['game', { 'm42-reveal': reveal }]} data-game>
  <script type="application/json" data-game-data set:html={json} />
  {first && (
    <>
      <div class="top">
        <span data-game-from>{first.de}</span>
        <span data-game-count>{fill(labels.counter, { n: 1, total })}</span>
      </div>
      <p class="text" data-game-text tabindex="-1">
        {first.texte}
      </p>
      <div role="group" aria-label="Votre réponse" class="choices" data-game-choices>
        <Button data-game-pick="a">{labels.scam}</Button>
        <Button variant="secondary" data-game-pick="f">
          {labels.legit}
        </Button>
      </div>
      <div aria-live="polite">
        <div class="feedback" data-game-feedback hidden>
          <p class="verdict" data-game-verdict></p>
          <p class="explain" data-game-explain></p>
          <p class="score" data-game-score hidden></p>
          <button type="button" class="next" data-game-next></button>
        </div>
      </div>
    </>
  )}
</div>

<style>
  .game {
    flex: 999 1 520px;
    min-width: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-card);
    font-weight: 500;
    line-height: 1.25;
  }

  /* Cible de focus programmatique (non interactive) */
  .text:focus {
    outline: none;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .choices[hidden],
  .feedback[hidden],
  .score[hidden] {
    display: none;
  }

  .feedback {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .verdict {
    margin: 0;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.4;
    color: var(--error);
  }

  .verdict[data-right='true'] {
    color: var(--success);
  }

  .explain {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .score {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
  }

  /* Petit bouton texte */
  .next {
    align-self: flex-start;
    min-height: var(--target-min);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color var(--dur-1) var(--ease-out);
  }

  .next:hover {
    color: var(--ink);
    text-decoration-color: var(--gold);
  }
</style>

<script>
  /* Îlot du jeu « Arnaque ou pas ? » (objet `q` de renderVals dans la maquette). */
  import { initialState, isLast, next, pick, score, type Choice, type QuizState } from './quiz';

  interface GameData {
    messages: { de: string; texte: string; arnaque: boolean; explication: string }[];
    labels: Record<string, string>;
  }

  const fill = (tpl: string, values: Record<string, number>): string =>
    tpl.replace(/\{(\w+)\}/g, (_m, key: string) => String(values[key] ?? ''));

  for (const root of document.querySelectorAll<HTMLElement>('[data-game]')) {
    const raw = root.querySelector('[data-game-data]')?.textContent;
    if (!raw) continue;
    const { messages, labels } = JSON.parse(raw) as GameData;
    const total = messages.length;

    const $ = <T extends HTMLElement>(sel: string): T | null => root.querySelector<T>(sel);
    const from = $('[data-game-from]');
    const count = $('[data-game-count]');
    const text = $('[data-game-text]');
    const choices = $('[data-game-choices]');
    const feedback = $('[data-game-feedback]');
    const verdict = $('[data-game-verdict]');
    const explain = $('[data-game-explain]');
    const scoreEl = $('[data-game-score]');
    const nextBtn = $<HTMLButtonElement>('[data-game-next]');
    if (!from || !count || !text || !choices || !feedback || !verdict || !explain || !scoreEl)
      continue;
    if (!nextBtn) continue;

    let state: QuizState = initialState();

    const render = (): void => {
      const q = messages[state.index];
      if (!q) return;
      const last = isLast(state, total);
      const answered = state.answer !== null;
      const right = state.results[state.index] === true;

      from.textContent = q.de;
      count.textContent = fill(labels.counter ?? '', { n: state.index + 1, total });
      text.textContent = q.texte;
      choices.hidden = answered;
      feedback.hidden = !answered;
      if (answered) {
        verdict.textContent =
          (right ? labels.right : labels.wrong) +
          (q.arnaque ? labels.verdictScam : labels.verdictLegit);
        verdict.dataset.right = String(right);
        explain.textContent = q.explication;
        scoreEl.hidden = !last;
        scoreEl.textContent = last ? fill(labels.score ?? '', { score: score(state), total }) : '';
        nextBtn.textContent = (last ? labels.restart : labels.next) ?? '';
      }
    };

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-game-pick]')) {
      btn.addEventListener('click', () => {
        const q = messages[state.index];
        if (!q) return;
        state = pick(state, btn.dataset.gamePick as Choice, q.arnaque);
        render();
        nextBtn.focus();
      });
    }

    nextBtn.addEventListener('click', () => {
      // Au dernier message, « Recommencer » remet le jeu à zéro (pas d'écran de fin ici).
      state = isLast(state, total) ? initialState() : next(state, total);
      render();
      text.focus();
    });
  }
</script>
