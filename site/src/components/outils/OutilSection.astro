---
/**
 * Section de la page outil : sur-titre à filet, H2 (Cormorant 2 à 3 rem), contenu (slot).
 * L'id du H2 est `${id}-t`.
 *
 * Props :
 * - id : ancre de la section (scroll-margin sous l'en-tête collant).
 * - eyebrow, title : textes de la maquette.
 * - measure : largeur max. du H2 (« 24ch » par défaut, « 20ch » pour « Les bons numéros »).
 * - spacing : « lg » (clamp(4rem, 8vw, 7rem) en haut et en bas), « night » (… 6rem, fond nuit),
 *   « bottom » (pas de marge haute : FAQ, qui suit la section précédente).
 * - ruled : filet haut de section (section « Quatre règles »).
 */
import Eyebrow from '../Eyebrow.astro';
import '../satellites/satellites.css';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  measure?: '24ch' | '20ch';
  spacing?: 'lg' | 'night' | 'bottom';
  ruled?: boolean;
}

const { id, eyebrow, title, measure = '24ch', spacing = 'lg', ruled = false } = Astro.props;
const night = spacing === 'night';
---

<section
  id={id}
  aria-labelledby={`${id}-t`}
  class:list={[
    'section',
    'sat-anchor',
    `section--${spacing}`,
    { 'section--ruled': ruled, 'm42-night': night },
  ]}
>
  <div class="inner">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 id={`${id}-t`} class:list={['title', measure === '20ch' ? 'title--20' : 'title--24']}>
      {title}
    </h2>
    <slot />
  </div>
</section>

<style>
  .section--lg {
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .section--night {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: var(--night);
    color: var(--on-night);
  }

  .section--bottom {
    padding: 0 0 clamp(4rem, 8vw, 7rem);
  }

  .section--ruled {
    border-top: 1px solid var(--line);
  }

  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
  }

  .title {
    margin: 20px 0 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-h2);
    color: var(--fg);
  }

  .title--24 {
    max-width: 24ch;
  }

  .title--20 {
    max-width: 20ch;
  }
</style>
