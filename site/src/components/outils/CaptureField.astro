---
/**
 * Champ obligatoire d'un bloc de capture (fiche à imprimer, kit de diffusion) :
 * libellé 14 px, champ sur fond papier, message d'erreur de la maquette affiché par l'îlot
 * de CaptureCard (relié par aria-describedby quand il est visible).
 *
 * Props :
 * - id, name, label : identifiant, nom du champ, libellé (avec « * »).
 * - type : « text » ou « email » ; `options` : liste déroulante (« Choisir… » en premier).
 * - autocomplete : jeton d'autoremplissage.
 * - error : message d'erreur (texte exact de la maquette).
 */
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email';
  options?: string[];
  autocomplete?: 'name' | 'organization' | 'email';
  error: string;
}

const { id, name, label, type = 'text', options, autocomplete, error } = Astro.props;
const errId = `${id}-err`;
---

<div class="field">
  <label for={id}>{label}</label>
  {options ? (
    <select id={id} name={name} required aria-required="true" class="control" data-error-id={errId}>
      <option value="">Choisir…</option>
      {options.map((o) => (
        <option>{o}</option>
      ))}
    </select>
  ) : (
    <input
      type={type}
      id={id}
      name={name}
      autocomplete={autocomplete}
      required
      aria-required="true"
      class="control"
      data-error-id={errId}
    />
  )}
  <p id={errId} class="error" hidden>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7.5v5.5"></path>
      <path d="M12 16.5h.01"></path>
    </svg>
    {error}
  </p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  label {
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }

  .control {
    box-sizing: border-box;
    width: 100%;
    min-height: var(--control-h);
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    line-height: 1.4;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .control:not([aria-invalid='true']):hover {
    border-color: var(--ink);
  }

  .control:focus {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .control[aria-invalid='true'] {
    padding: 11px 13px;
    border: 2px solid var(--error);
  }

  .error {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--error);
  }

  .error[hidden] {
    display: none;
  }
</style>
