---
/**
 * Test « Arnaque ou pas ? » en 8 situations (Sat-test-arnaque-ou-pas.dc.html, bloc #test).
 * Une situation à la fois : « Arnaque » / « Fiable », verdict, explication et règle annoncés
 * (aria-live), puis « Situation suivante » ; après la 8e, l'écran de résultat (role="status"),
 * la liste des situations manquées et « Recommencer le test ». Aucune réponse n'est enregistrée.
 *
 * Moteur : conferences/quiz.ts (lecture seule, partagé avec le jeu de la conférence II).
 * Rendu serveur : état initial de la maquette (situation 1, score « 0 sur 0 »).
 * Focus (componentDidUpdate de la maquette) : après une réponse, sur le bloc de réponse ;
 * après « Situation suivante » ou « Recommencer », sur le titre de la situation ;
 * après la dernière, sur le bloc de résultat.
 * Sans JavaScript (@media (scripting: none)) : la partie interactive est masquée et les
 * 8 situations, avec leur réponse, sont lisibles dans un <noscript>.
 *
 * Props :
 * - situations : les 8 situations (src/data/outils/arnaque-ou-pas.ts).
 * - labels : libellés de l'îlot ; results : textes de l'écran de fin.
 */
import Button from '../Button.astro';
import ArrowLink from '../ArrowLink.astro';
import { frenchTypography } from '../../lib/typo';
import type { Situation, TestLabels, TestResults } from '../../data/outils/arnaque-ou-pas';
import '../satellites/satellites.css';

interface Props {
  situations: Situation[];
  labels: TestLabels;
  results: TestResults;
}

const { situations, labels, results } = Astro.props;
const first = situations[0];

const fill = (tpl: string, values: Record<string, string | number>): string =>
  tpl.replace(/\{(\w+)\}/g, (_m, key: string) => String(values[key] ?? ''));

// Données de l'îlot : typographie française déjà appliquée (le middleware ne traite pas <script>).
const typo = (s: string): string => frenchTypography(s);
const data = {
  situations: situations.map((s) => ({
    titre: typo(s.titre),
    canal: typo(s.canal),
    ctx: typo(s.ctx),
    msg: typo(s.msg),
    scam: s.scam,
    answer: typo(s.answer),
    explain: typo(s.explain),
    ruleLabel: typo(s.ruleLabel),
    rule: typo(s.rule),
  })),
  labels: Object.fromEntries(Object.entries(labels).map(([k, v]) => [k, typo(v)])),
  results: {
    perfect: { titre: typo(results.perfect.titre), texte: typo(results.perfect.texte) },
    good: {
      min: results.good.min,
      titre: typo(results.good.titre),
      texte: typo(results.good.texte),
    },
    low: { titre: typo(results.low.titre), texte: typo(results.low.texte) },
  },
};
// Pas de « < » brut dans le bloc JSON (aucune fermeture de balise possible).
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div id="test" class="test sat-anchor" data-test>
  <script type="application/json" data-test-data set:html={json} />
  <div class="head">
    <h2 id="test-t" class="heading">
      {labels.heading}
    </h2>
    <p class="tally live-only" data-tally>
      {fill(labels.tally, { score: 0, answered: 0 })}
    </p>
  </div>
  <div aria-hidden="true" class="dots live-only">
    {situations.map((_s, i) => (
      <span class:list={['dot', { 'dot--current': i === 0 }]} data-dot />
    ))}
  </div>

  {first && (
    <div class="quiz live-only" data-quiz>
      <p class="counter" data-counter>
        {fill(labels.counter, { n: 1, canal: first.canal })}
      </p>
      <h3 class="title" tabindex="-1" data-title>
        {first.titre}
      </h3>
      <p class="ctx" data-ctx>
        {first.ctx}
      </p>
      <blockquote class="msg" data-msg hidden={!first.msg}>
        {first.msg}
      </blockquote>
      <div role="group" aria-label="Votre réponse" class="choices" data-choices>
        <button type="button" class="choice" data-pick="a">
          {labels.scam}
        </button>
        <button type="button" class="choice" data-pick="f">
          {labels.legit}
        </button>
      </div>
      <div aria-live="polite">
        <div class="feedback" tabindex="-1" data-feedback hidden>
          <p class="verdict" data-verdict></p>
          <p class="explain" data-explain></p>
          <div class="rule">
            <p class="rule-label" data-rule-label></p>
            <p class="rule-text" data-rule></p>
          </div>
          <Button class="test-next" data-next>
            <span>
              <span data-next-label>{labels.next}</span> <span aria-hidden="true">→</span>
            </span>
          </Button>
        </div>
      </div>
    </div>
  )}

  <div class="result live-only" tabindex="-1" role="status" data-result hidden>
    <p class="result-eyebrow">{labels.resultEyebrow}</p>
    <p class="result-score" data-result-score></p>
    <h3 class="result-title" data-result-title></h3>
    <p class="result-text" data-result-text></p>
    <div class="missed" data-missed hidden>
      <p class="missed-title">{labels.missedTitle}</p>
      <ul class="missed-list" data-missed-list></ul>
    </div>
    <div class="result-actions">
      <Button data-restart>{labels.restart}</Button>
      <ArrowLink href="#regles">{labels.rulesLink}</ArrowLink>
    </div>
  </div>

  <noscript>
    <ol class="static">
      {situations.map((s, i) => (
        <li class="static-item">
          <p class="counter">{fill(labels.counter, { n: i + 1, canal: s.canal })}</p>
          <h3 class="title">{s.titre}</h3>
          <p class="ctx">{s.ctx}</p>
          {s.msg && <blockquote class="msg">{s.msg}</blockquote>}
          <div class="feedback">
            <p class:list={['verdict', { 'verdict--scam': s.scam }]}>{s.answer}</p>
            <p class="explain">{s.explain}</p>
            <div class="rule">
              <p class="rule-label">{s.ruleLabel}</p>
              <p class="rule-text">{s.rule}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </noscript>

  <p class="note">{labels.note}</p>
</div>

<style>
  .test {
    flex: 1.25 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(20px, 3vw, 36px);
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  /* Sans JavaScript : partie interactive masquée, situations lisibles dans le <noscript> */
  @media (scripting: none) {
    .live-only {
      display: none !important;
    }
  }

  [hidden] {
    display: none !important;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px var(--s-4);
  }

  .heading {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tally,
  .counter {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-3);
  }

  /* Barre de progression : 8 segments */
  .dots {
    display: flex;
    gap: var(--s-1);
  }

  .dot {
    flex: 1 1 0;
    height: 4px;
    background-color: var(--line);
  }

  .dot--current {
    background-color: var(--ink);
  }

  .dot--right {
    background-color: var(--success);
  }

  .dot--wrong {
    background-color: var(--error);
  }

  .quiz {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    line-height: 1.08;
    color: var(--ink);
  }

  /* Cibles de focus programmatique (non interactives), comme dans la maquette */
  .title:focus,
  .feedback:focus,
  .result:focus {
    outline: none;
  }

  .ctx {
    margin: 0;
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .msg {
    margin: 0;
    max-width: 60ch;
    padding: var(--s-4) 20px;
    background: var(--paper-sunk);
    border-left: 3px solid var(--line-strong);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    padding-top: var(--s-1);
  }

  /* Boutons de réponse : .m42-btn2 de la maquette, en 17 px gras et 56 px de haut */
  .choice {
    flex: 1 1 180px;
    min-height: 56px;
    padding: 15px var(--s-5);
    box-sizing: border-box;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .choice:hover {
    background-color: var(--ink-hover);
  }

  .choice:active {
    transform: translateY(1px);
  }

  .feedback {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .feedback :global(.test-next) {
    align-self: flex-start;
  }

  .verdict {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--error);
  }

  .verdict[data-right='true'] {
    color: var(--success);
  }

  /* Version sans JavaScript : réponse en encre (pas de bonne ou mauvaise réponse) */
  .static .verdict {
    color: var(--ink);
  }

  .explain {
    margin: 0;
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .rule {
    max-width: 62ch;
    padding: 14px 18px;
    background: var(--paper);
    border-left: 3px solid var(--gold);
  }

  .rule-label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .rule-text {
    margin: 6px 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Écran de résultat */
  .result {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .result-eyebrow {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .result-score {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-figure);
    line-height: var(--lh-figure);
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink);
  }

  .result-title {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
    color: var(--ink);
  }

  .result-text {
    margin: 0;
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .missed {
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }

  .missed-title {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: var(--lh-small);
    color: var(--ink);
  }

  .missed-list {
    margin: var(--s-2) 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .result-actions {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  /* Les 8 situations sans JavaScript */
  .static {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .static-item {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .static-item + .static-item {
    border-top: 1px solid var(--line);
    padding-top: var(--s-6);
  }

  .note {
    margin: 0;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .choice:active {
      transform: none;
    }
  }
</style>

<script>
  /*
   * Îlot du test « Arnaque ou pas ? » (classe Component de la maquette : renderVals(),
   * pick / next / restart, componentDidUpdate pour le focus). Rien n'est enregistré ni envoyé.
   */
  import {
    initialState,
    isLast,
    missed,
    next,
    pick,
    score,
    type Choice,
    type QuizState,
  } from '../conferences/quiz';

  interface SituationData {
    titre: string;
    canal: string;
    ctx: string;
    msg: string;
    scam: boolean;
    answer: string;
    explain: string;
    ruleLabel: string;
    rule: string;
  }

  interface ResultText {
    titre: string;
    texte: string;
  }

  interface TestData {
    situations: SituationData[];
    labels: Record<string, string>;
    results: { perfect: ResultText; good: ResultText & { min: number }; low: ResultText };
  }

  type FocusTarget = 'title' | 'feedback' | 'result';

  const fill = (tpl: string, values: Record<string, string | number>): string =>
    tpl.replace(/\{(\w+)\}/g, (_m, key: string) => String(values[key] ?? ''));

  function mount(root: HTMLElement): void {
    const raw = root.querySelector('[data-test-data]')?.textContent;
    if (!raw) return;
    const { situations, labels, results } = JSON.parse(raw) as TestData;
    const total = situations.length;
    const label = (key: string): string => labels[key] ?? '';

    const $ = <T extends HTMLElement = HTMLElement>(sel: string): T | null =>
      root.querySelector<T>(sel);
    const tally = $('[data-tally]');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const quiz = $('[data-quiz]');
    const counter = $('[data-counter]');
    const title = $('[data-title]');
    const ctx = $('[data-ctx]');
    const msg = $('[data-msg]');
    const choices = $('[data-choices]');
    const feedback = $('[data-feedback]');
    const verdict = $('[data-verdict]');
    const explain = $('[data-explain]');
    const ruleLabel = $('[data-rule-label]');
    const rule = $('[data-rule]');
    const nextBtn = $<HTMLButtonElement>('[data-next]');
    const nextLabel = $('[data-next-label]');
    const result = $('[data-result]');
    const resultScore = $('[data-result-score]');
    const resultTitle = $('[data-result-title]');
    const resultText = $('[data-result-text]');
    const missedBox = $('[data-missed]');
    const missedList = $('[data-missed-list]');
    const restartBtn = $<HTMLButtonElement>('[data-restart]');
    if (
      !tally ||
      !quiz ||
      !counter ||
      !title ||
      !ctx ||
      !msg ||
      !choices ||
      !feedback ||
      !verdict ||
      !explain ||
      !ruleLabel ||
      !rule ||
      !nextBtn ||
      !nextLabel ||
      !result ||
      !resultScore ||
      !resultTitle ||
      !resultText ||
      !missedBox ||
      !missedList ||
      !restartBtn
    )
      return;

    let state: QuizState = initialState();

    const focusOn = (target: FocusTarget): void => {
      const el = target === 'title' ? title : target === 'feedback' ? feedback : result;
      // Après le rendu (setTimeout 0 dans la maquette).
      window.setTimeout(() => el.focus(), 0);
    };

    const render = (): void => {
      const s = score(state);
      const answered = state.results.filter((r) => r === true || r === false).length;
      tally.textContent = fill(label('tally'), { score: s, answered });

      dots.forEach((dot, i) => {
        const r = state.results[i];
        dot.classList.toggle('dot--right', r === true);
        dot.classList.toggle('dot--wrong', r === false);
        dot.classList.toggle(
          'dot--current',
          r === undefined && !state.finished && i === state.index,
        );
      });

      quiz.hidden = state.finished;
      result.hidden = !state.finished;

      if (state.finished) {
        const res =
          s === total ? results.perfect : s >= results.good.min ? results.good : results.low;
        resultScore.textContent = fill(label('resultScore'), { score: s });
        resultTitle.textContent = res.titre;
        resultText.textContent = res.texte;
        const misses = missed(state);
        missedBox.hidden = misses.length === 0;
        missedList.replaceChildren(
          ...misses.map((i) => {
            const li = document.createElement('li');
            li.textContent = `${i + 1}. ${situations[i]?.titre ?? ''}`;
            return li;
          }),
        );
        return;
      }

      const q = situations[state.index];
      if (!q) return;
      const answeredNow = state.answer !== null;
      const right = state.results[state.index] === true;

      counter.textContent = fill(label('counter'), { n: state.index + 1, canal: q.canal });
      title.textContent = q.titre;
      ctx.textContent = q.ctx;
      msg.textContent = q.msg;
      msg.hidden = !q.msg;
      choices.hidden = answeredNow;
      feedback.hidden = !answeredNow;
      if (answeredNow) {
        verdict.textContent = (right ? label('right') : label('wrong')) + q.answer;
        verdict.dataset.right = String(right);
        explain.textContent = q.explain;
        ruleLabel.textContent = q.ruleLabel;
        rule.textContent = q.rule;
        nextLabel.textContent = isLast(state, total) ? label('last') : label('next');
      }
    };

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-pick]')) {
      btn.addEventListener('click', () => {
        const q = situations[state.index];
        if (!q || state.answer !== null || state.finished) return;
        state = pick(state, btn.dataset.pick as Choice, q.scam);
        render();
        focusOn('feedback');
      });
    }

    nextBtn.addEventListener('click', () => {
      state = next(state, total);
      render();
      focusOn(state.finished ? 'result' : 'title');
    });

    restartBtn.addEventListener('click', () => {
      state = initialState();
      render();
      focusOn('title');
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-test]').forEach(mount);
</script>
