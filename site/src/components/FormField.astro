---
/**
 * Champ de formulaire : libellé au-dessus (Inter 14 px 500), champ encadré de 48 px.
 * Aide facultative (13 px, sous le champ). Erreur : message texte + icône, relié par
 * aria-describedby, bordure 2 px — jamais la couleur seule.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'date' | 'number' | 'select' | 'textarea';
  required?: boolean;
  autocomplete?: string;
  /** Liste déroulante : valeurs simples ou couples valeur/libellé. */
  options?: (string | Option)[];
  /** Premier choix vide d'une liste déroulante. */
  emptyOption?: string;
  hint?: string;
  error?: string;
  rows?: number;
  value?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  options = [],
  emptyOption = 'Choisir…',
  hint,
  error,
  rows = 6,
  value,
} = Astro.props;

const hintId = hint ? `${id}-aide` : undefined;
const errorId = error ? `${id}-err` : undefined;
const describedby = [hintId, errorId].filter(Boolean).join(' ') || undefined;
const common = {
  id,
  name,
  required,
  autocomplete,
  'aria-describedby': describedby,
  'aria-invalid': error ? ('true' as const) : undefined,
};
const opts: Option[] = options.map((o) => (typeof o === 'string' ? { value: o, label: o } : o));
---

<div class="field">
  <label for={id}>
    {label}
    {required && ' *'}
  </label>
  {type === 'select' ? (
    <select class="control" {...common}>
      <option value="">{emptyOption}</option>
      {opts.map((o) => (
        <option value={o.value} selected={o.value === value}>
          {o.label}
        </option>
      ))}
    </select>
  ) : type === 'textarea' ? (
    <textarea class="control control--area" rows={rows} {...common}>
        {value}
      </textarea>
  ) : (
    <input class="control" type={type} value={value} {...common} />
  )}
  {hint && (
    <p id={hintId} class="hint">
      {hint}
    </p>
  )}
  {error && (
    <p id={errorId} class="error">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5v5.5" />
        <path d="M12 16.5h.01" />
      </svg>
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }

  .control {
    box-sizing: border-box;
    width: 100%;
    min-height: var(--control-h);
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    line-height: 1.4;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .control--area {
    min-height: 160px;
    resize: vertical;
  }

  .control:not([aria-invalid='true']):hover {
    border-color: var(--ink);
  }

  .control:focus {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .control[aria-invalid='true'] {
    padding: 11px 13px;
    border: 2px solid var(--error);
  }

  .hint {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .error {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--error);
  }
</style>
