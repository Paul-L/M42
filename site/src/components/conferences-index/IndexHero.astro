---
/**
 * En-tête de /conferences/ (kit/maquette/Conferences.dc.html, section « titre-page ») :
 * fil d'Ariane, H1 (sur-titre + titre), chapô, deux boutons, et à droite la navigation
 * « En un coup d'œil » (ancres vers les cartes I à IV et vers #sur-mesure).
 * Aucune animation d'entrée (au-dessus de la ligne de flottaison).
 *
 * Props :
 * - ariane : fil d'Ariane (dernier élément = page courante).
 * - surTitre, titre : H1 (sur-titre dans le H1, sans filet).
 * - chapo : texte sous le H1.
 * - ctaPrincipal, ctaSecondaire : boutons.
 * - nav : { label (nom accessible), surTitre, items: { numero?, label, note?, href }[] }.
 *   Sans `numero`, la ligne affiche « + » (Sur mesure).
 */
import Breadcrumb, { type Crumb } from '../Breadcrumb.astro';
import Button from '../Button.astro';
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import type { Lien } from '../../data/conferences/types';

export interface LigneCoupDoeil {
  numero?: string;
  label: string;
  /** Mention discrète après le titre (« · signature »). */
  note?: string;
  href: string;
}

interface Props {
  ariane: Crumb[];
  surTitre: string;
  titre: string;
  chapo: string;
  ctaPrincipal: Lien;
  ctaSecondaire: Lien;
  nav: { label: string; surTitre: string; items: LigneCoupDoeil[] };
}

const { ariane, surTitre, titre, chapo, ctaPrincipal, ctaSecondaire, nav } = Astro.props;
---

<section aria-labelledby="titre-page" class="hero">
  <Container>
    <Breadcrumb items={ariane} />
    <div class="row">
      <div class="main">
        <h1 id="titre-page" class="h1">
          <Eyebrow as="span" rule={false}>
            {surTitre}
          </Eyebrow>
          <span class="h1-title">{titre}</span>
        </h1>
        <p class="lead">{chapo}</p>
        <div class="actions">
          <Button href={ctaPrincipal.href}>{ctaPrincipal.label}</Button>
          <Button href={ctaSecondaire.href} variant="secondary">
            {ctaSecondaire.label}
          </Button>
        </div>
      </div>
      <nav aria-label={nav.label} class="glance">
        <p class="glance-title">{nav.surTitre}</p>
        <ol class="glance-list">
          {nav.items.map((item) => (
            <li>
              <a href={item.href} class="glance-link">
                {item.numero ? (
                  <span aria-hidden="true" class="numeral">
                    {item.numero}
                  </span>
                ) : (
                  <span aria-hidden="true" class="plus">
                    +
                  </span>
                )}
                <span class="label">
                  {item.label}
                  {item.note && (
                    <>
                      {' '}
                      <span class="note">{item.note}</span>
                    </>
                  )}
                </span>
                <span class="arrow-i" aria-hidden="true">
                  ↓
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 4vw, 3.5rem) 0 clamp(4rem, 7vw, 6rem);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 48px 64px;
  }

  .main {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-weight: 400;
  }

  .h1-title {
    max-width: var(--measure-h1);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tracking-h1);
    color: var(--ink);
  }

  .lead {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* En un coup d'œil */
  .glance {
    flex: 1 1 320px;
    min-width: 0;
  }

  .glance-title {
    margin: 0 0 4px;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .glance-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .glance-list li {
    border-bottom: 1px solid var(--line);
  }

  /* Lien fléché de la maquette (.m42-arrow), soulignement retiré par le style en ligne */
  .glance-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-height: var(--control-h);
    padding: 12px 0;
    box-sizing: border-box;
    color: var(--ink);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
  }

  .numeral,
  .plus {
    width: 28px;
    color: var(--gold-deep);
  }

  .numeral {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 28px;
    line-height: 1;
  }

  .plus {
    font-size: 18px;
  }

  .label {
    flex: 1;
  }

  .note {
    font-weight: 400;
    color: var(--ink-3);
  }

  .arrow-i {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .glance-link:hover .arrow-i {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .glance-link:hover .arrow-i {
      transform: none;
    }
  }
</style>
