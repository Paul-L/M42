---
/**
 * FAQ en <details> (questions en H3, réponses de 40 à 80 mots).
 * `answer` accepte du HTML simple (liens, gras) ; il sera identique au balisage FAQPage.
 */
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details class="item">
      <summary>
        <h3>{item.question}</h3>
        <span class="icon" aria-hidden="true">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            focusable="false"
          >
            <path d="M12 5v14" />
            <path d="M5 12h14" />
          </svg>
        </span>
      </summary>
      <div class="answer" set:html={item.answer} />
    </details>
  ))}
</div>

<style>
  .faq {
    max-width: 52rem;
    border-top: 1px solid var(--rule);
  }

  .item {
    border-bottom: 1px solid var(--hairline);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 48px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    margin: 0;
    font-size: var(--fs-faq);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: var(--tracking-h3);
  }

  summary:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 4px;
  }

  .icon {
    flex: none;
    display: inline-flex;
    color: var(--fg);
    transition: transform var(--dur-2) var(--ease-in-out);
  }

  .item[open] .icon {
    transform: rotate(45deg);
  }

  .answer {
    padding: 0 0 24px;
    max-width: var(--measure-text);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg-2);
  }

  .answer :global(p) {
    margin: 0;
  }

  .answer :global(p + p) {
    margin-top: 12px;
  }
</style>
