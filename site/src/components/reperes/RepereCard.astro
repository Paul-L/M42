---
/**
 * Carte de la bibliothèque des repères (maquette Reperes.dc.html).
 * - disponible : carte cliquable (lien du titre étendu à toute la carte, barre or au survol),
 *   comme ConferenceCard mais avec un sur-titre de type et sans chiffre romain ni tags.
 * - bientot : carte en pointillés, non cliquable, pastille « Bientôt » et marqueur [À PRODUIRE].
 * `data-publics` sert au filtrage par l'îlot de RepereLibrary.
 */
import { bibliotheque, pourLabel, type Repere } from '../../data/reperes';

interface Props {
  repere: Repere;
}

const { repere } = Astro.props;
const pour = pourLabel(repere.publics);
const publics = repere.publics.join(' ');
---

{repere.statut === 'disponible' ? (
  <article class="card" data-repere data-publics={publics}>
    <p class="type">{repere.type}</p>
    <h3 class="title">
      <a href={repere.href} class="stretch">
        {repere.titre}
      </a>
    </h3>
    <p class="desc">{repere.description}</p>
    <p class="pour">{pour}</p>
    <span class="cta" aria-hidden="true">
      {repere.cta} <span class="arrow-i">→</span>
    </span>
    <span class="bar" aria-hidden="true"></span>
  </article>
) : (
  <article class="soon" data-repere data-publics={publics}>
    <div class="soon-top">
      <p class="type type--soon">{repere.type}</p>
      <span class="badge">{bibliotheque.bientot.badge}</span>
    </div>
    <h3 class="title">{repere.titre}</h3>
    <p class="desc desc--soon">{repere.description}</p>
    <p class="pour">{pour}</p>
    <p class="todo">{bibliotheque.bientot.marqueur}</p>
  </article>
)}

<style>
  /* Repère disponible */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 28px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .card:hover {
    border-color: var(--ink);
  }

  .card[hidden],
  .soon[hidden] {
    display: none;
  }

  .type {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    color: var(--ink);
  }

  .stretch {
    color: var(--ink);
    text-decoration: none;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .stretch:focus-visible {
    outline: none;
  }

  .stretch:focus-visible::after {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .pour {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .cta {
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .card:hover .cta {
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
  }

  .arrow-i {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .card:hover .arrow-i {
    transform: translateX(3px);
  }

  .bar {
    position: absolute;
    left: -1px;
    right: -1px;
    bottom: -1px;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .card:hover .bar,
  .card:focus-within .bar {
    transform: scaleX(1);
  }

  /* Repère en préparation */
  .soon {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px dashed var(--line-strong);
    background: transparent;
  }

  .soon-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .type--soon {
    color: var(--ink-3);
  }

  .badge {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--ink-3);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .desc--soon {
    font-size: 15px;
  }

  .todo {
    margin: auto 0 0;
    padding-top: 4px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .arrow-i {
      transform: none;
    }
  }
</style>
