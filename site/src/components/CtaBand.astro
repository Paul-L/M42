---
/**
 * Bandeau sombre d'appel à l'action (fin de page, avant le pied de page).
 * Le bloc de contact par défaut reprend le gabarit (e-mails + téléphone à compléter) ;
 * il peut être remplacé par le slot « contact ».
 */
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  id = 'cta-t',
  eyebrow = 'Contact',
  title,
  lead,
  ctaLabel = 'Organiser une intervention',
  ctaHref = '/contact/',
} = Astro.props;
---

<section class="cta m42-night" aria-labelledby={id}>
  <div class="cta-inner">
    <Eyebrow>{eyebrow}</Eyebrow>
    <div class="row">
      <div class="text">
        <h2 id={id} class="title">
          {title}
        </h2>
        {lead && <p class="lead">{lead}</p>}
      </div>
      <div class="actions">
        <Button href={ctaHref}>{ctaLabel}</Button>
        {Astro.slots.has('contact') ? (
          <slot name="contact" />
        ) : (
          <p class="contact">
            Clara : <a href="mailto:clara@m42.guide">clara@m42.guide</a>
            <br />
            Paul : <a href="mailto:paul@m42.guide">paul@m42.guide</a>
            <br />
            [À COMPLÉTER : téléphone]
          </p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--night);
    color: var(--on-night);
    padding: var(--section-y) 0;
  }

  .cta-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
  }

  .row {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 64px;
  }

  .text {
    flex: 1 1 520px;
    min-width: 0;
  }

  .title {
    margin: 0;
    max-width: var(--measure-h2);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--tracking-h2);
  }

  .lead {
    margin: 20px 0 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--on-night-2);
  }

  .actions {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .contact {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-night-2);
  }

  .contact a {
    color: var(--on-night);
    text-underline-offset: 3px;
  }
</style>
