---
/**
 * « Repères : à utiliser dès aujourd'hui » : trois repères disponibles (cartes-liens,
 * <a> englobant comme dans la maquette) et un repère à venir (pointillés, non cliquable).
 * Fond des cartes #F7F4EE : valeur exacte de la maquette (aucun token ne la porte ;
 * --paper-raised vaut #F8F6F1).
 */
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import { reperes } from '../../data/accueil';
import { routes } from '../../data/routes';
---

<section id="reperes" aria-labelledby="titre-reperes" class="reperes">
  <Container>
    <Eyebrow class="m42-reveal">Repères</Eyebrow>
    <div class="row m42-reveal">
      <h2 id="titre-reperes" class="title">
        À utiliser dès aujourd'hui
      </h2>
      <p class="lead">
        Des outils gratuits, simples et vérifiés, pour vous, vos équipes ou vos habitants.{' '}
        <a href={routes['Reperes.dc.html']} class="more">
          Tous les repères{' '}
          <span class="arrow-i" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
    <div class="grid">
      {reperes.map((r) =>
        r.href ? (
          <a href={r.href} class="card m42-reveal">
            <span class="type">{r.type}</span>
            <span class="name">{r.titre}</span>
            <span class="desc">{r.description}</span>
            <span class="cta">{r.cta}</span>
          </a>
        ) : (
          <div class="card card--soon m42-reveal">
            <span class="type type--soon">{r.type}</span>
            <span class="name">{r.titre}</span>
            <span class="desc">{r.description}</span>
          </div>
        ),
      )}
    </div>
  </Container>
</section>

<style>
  .reperes {
    padding: clamp(2rem, 4vw, 4rem) 0 var(--section-y);
  }

  .row {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5) var(--s-8);
  }

  .title {
    margin: 0;
    max-width: var(--measure-h2);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--tracking-h2);
  }

  .lead {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: var(--lh-lead);
    color: var(--ink-2);
  }

  /* Lien fléché en ligne (.m42-arrow) */
  .more {
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .more:hover {
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
  }

  .arrow-i {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .more:hover .arrow-i {
    transform: translateX(3px);
  }

  .grid {
    margin-top: var(--s-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-5);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--line);
    background: #f7f4ee;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  a.card:hover {
    border-color: var(--ink);
  }

  .card--soon {
    border: 1px dashed var(--line-strong);
    background: transparent;
  }

  .type {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .type--soon {
    color: var(--ink-3);
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .cta {
    margin-top: auto;
    font-size: 15px;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .more:hover .arrow-i {
      transform: none;
    }
  }
</style>
