---
/**
 * « Vos enjeux » des pages « Pour qui » : grille d'enjeux numérotés (« 01 », « 02 »…),
 * filet fin, numéro or, H3, texte, source facultative (12 px). Chaque enjeu apparaît au défilement.
 *
 * Props :
 * - `items` : { title, text, source? } (PublicStake, src/data/publics/types.ts) ;
 *   le numéro est calculé (01, 02…).
 */
import type { PublicStake } from '../../data/publics/types';

export interface Props {
  items: PublicStake[];
}

const { items } = Astro.props;
---

<div class="grid">
  {items.map((item, i) => (
    <div class="item m42-reveal">
      <span aria-hidden="true" class="num">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3 class="h3">{item.title}</h3>
      <p class="text">{item.text}</p>
      {item.source && <p class="source">{item.source}</p>}
    </div>
  ))}
</div>

<style>
  .grid {
    margin-top: var(--s-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 40px var(--s-7);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-5);
  }

  .num {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-text);
  }

  .h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  .text {
    margin: 0;
    max-width: var(--measure-text);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg-2);
    hyphens: auto;
  }

  .source {
    margin: var(--s-1) 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--fg-3);
  }
</style>
