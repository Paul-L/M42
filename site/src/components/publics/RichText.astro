---
/**
 * Texte avec marqueurs de relecture en ligne (pages « Pour qui ») : rend une chaîne, ou une suite
 * de segments où `{ marker }` devient une étiquette DraftMarker (marqueur au milieu d'une phrase).
 * Ne crée aucun élément englobant : à placer dans un <p>, un <span>…
 *
 * Props :
 * - `value` : PublicRichText (src/data/publics/types.ts).
 */
import DraftMarker from './DraftMarker.astro';
import type { PublicRichText } from '../../data/publics/types';

export interface Props {
  value: PublicRichText;
}

const { value } = Astro.props;
const segments = typeof value === 'string' ? [value] : value;
---

{segments.map((seg) =>
  typeof seg === 'string' ? <Fragment>{seg}</Fragment> : <DraftMarker>{seg.marker}</DraftMarker>,
)}
