---
/**
 * Marqueur de relecture en ligne (« [À VALIDER : …] », « [À PRODUIRE] ») :
 * petite étiquette en pointillés, insécable, placée après un texte (marge gauche 6 px).
 * Slot : texte du marqueur, tel qu'écrit dans la maquette.
 */
---

<span class="marker">
  <slot />
</span>

<style>
  .marker {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 6px;
    border: 1px dashed var(--control-border);
    color: var(--fg-3);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    vertical-align: 1px;
  }
</style>
