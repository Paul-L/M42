---
/**
 * Grille des conférences recommandées des pages « Pour qui » : cartes PublicConferenceCard sur
 * deux colonnes (440 px minimum), gouttière 24 px, à 48 px sous le titre de section.
 *
 * Props :
 * - `items` : PublicRecommendedConference[] (src/data/publics/types.ts), dans l'ordre de la maquette.
 * - `labels` : intitulés des cartes (« Pour vous : », « Conférence signature »,
 *   « Voir le programme ») tirés de `labels` (PublicPage) ; défauts de PublicConferenceCard sinon.
 */
import PublicConferenceCard from './PublicConferenceCard.astro';
import type { PublicLabels, PublicRecommendedConference } from '../../data/publics/types';

export interface Props {
  items: PublicRecommendedConference[];
  labels?: Pick<PublicLabels, 'forYou' | 'signature' | 'conferenceCta'>;
}

const { items, labels } = Astro.props;
---

<div class="cards">
  {items.map((c) => (
    <PublicConferenceCard
      numeral={c.numeral}
      signature={c.signature}
      title={c.title}
      href={c.href}
      summary={c.summary}
      forYou={c.forYou}
      formats={c.formats}
      forYouLabel={labels?.forYou}
      signatureLabel={labels?.signature}
      cta={labels?.conferenceCta}
    />
  ))}
</div>

<style>
  .cards {
    margin-top: var(--s-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: var(--s-5);
  }
</style>
