---
/**
 * Liste des formats des pages « Pour qui » : une ligne par format (H3, précision facultative
 * dessous avec marqueurs en ligne possibles, colonnes « Durée » et « Participants »), puis une
 * note facultative sous la liste (« Sur site, chez vous… »). Liste et note apparaissent au
 * défilement.
 *
 * Props :
 * - `items` : { title, note?, duration, participants } (PublicFormat, src/data/publics/types.ts) ;
 *   `note` est un PublicRichText (« Mises en situation… », `[{ marker: '[À VALIDER : …]' }]`).
 * - `footnote` : paragraphe sous la liste (16 px, encre 2, 68ch).
 * - `durationLabel` (« Durée ») / `participantsLabel` (« Participants ») : intitulés des colonnes.
 */
import RichText from './RichText.astro';
import type { PublicFormat } from '../../data/publics/types';

export interface Props {
  items: PublicFormat[];
  footnote?: string;
  durationLabel?: string;
  participantsLabel?: string;
}

const {
  items,
  footnote,
  durationLabel = 'Durée',
  participantsLabel = 'Participants',
} = Astro.props;
---

<ul class="list m42-reveal">
  {items.map((item) => (
    <li class="row">
      <div class="name">
        <h3 class="h3">{item.title}</h3>
        {item.note && (
          <p class="note">
            <RichText value={item.note} />
          </p>
        )}
      </div>
      <div class="cell cell--duration">
        <span class="label">{durationLabel}</span>
        <span class="value">{item.duration}</span>
      </div>
      <div class="cell cell--people">
        <span class="label">{participantsLabel}</span>
        <span class="value">{item.participants}</span>
      </div>
    </li>
  ))}
</ul>
{footnote && <p class="footnote m42-reveal">{footnote}</p>}

<style>
  .list {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3) var(--s-6);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .name {
    flex: 2 1 320px;
    min-width: 0;
  }

  .h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  .note {
    margin: 6px 0 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--fg-3);
  }

  .cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .cell--duration {
    flex: 1 1 170px;
  }

  .cell--people {
    flex: 1 1 220px;
  }

  .label {
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .value {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--fg);
  }

  .footnote {
    margin: var(--s-5) 0 0;
    max-width: var(--measure-text);
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg-2);
  }
</style>
