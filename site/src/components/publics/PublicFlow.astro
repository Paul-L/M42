---
/**
 * Schéma en étapes fléchées des pages « Pour qui » (ex. « Commander une intervention » sur
 * Collectivités) : cartes numérotées reliées par des flèches, liste ARIA (role="list").
 * Les flèches horizontales deviennent verticales sous 640 px. Le schéma apparaît au défilement.
 *
 * Props :
 * - `label` : nom accessible de la liste (« Les trois étapes de la commande »).
 * - `items` : étapes { title, text } ; `text` accepte des marqueurs en ligne (PublicRichText).
 */
import RichText from './RichText.astro';
import type { PublicRichText } from '../../data/publics/types';

export interface PublicFlowStep {
  title: string;
  text: PublicRichText;
}

export interface Props {
  label: string;
  items: PublicFlowStep[];
}

const { label, items } = Astro.props;
---

<div class="flow m42-reveal" role="list" aria-label={label}>
  {items.map((item, i) => (
    <>
      {i > 0 && (
        <span class="arrow" aria-hidden="true">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            <path d="M4 12h16" />
            <path d="M14 6l6 6-6 6" />
          </svg>
        </span>
      )}
      <div role="listitem" class="step">
        <span aria-hidden="true" class="num">
          {i + 1}
        </span>
        <h3 class="h3">{item.title}</h3>
        <p class="text">
          <RichText value={item.text} />
        </p>
      </div>
    </>
  ))}
</div>

<style>
  .flow {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: var(--s-4);
  }

  .step {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
  }

  .num {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 40px;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--accent-text);
  }

  .h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  .text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg-2);
  }

  .arrow {
    flex: none;
    align-self: center;
    display: inline-flex;
    color: var(--fg);
  }

  /* Les flèches horizontales deviennent verticales sous 640 px */
  @media (max-width: 639px) {
    .arrow {
      transform: rotate(90deg);
    }
  }
</style>
