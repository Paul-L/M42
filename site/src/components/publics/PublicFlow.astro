---
/**
 * Schéma en étapes fléchées des pages « Pour qui » (« Commander une intervention » sur
 * Collectivités, « Le relais » sur Associations) : cartes numérotées reliées par des flèches,
 * liste ARIA (role="list"). Les flèches horizontales deviennent verticales sous 640 px.
 * Le schéma, puis la note facultative, apparaissent au défilement.
 *
 * Props :
 * - `label` : nom accessible de la liste (« Les trois étapes de la commande »).
 * - `items` : étapes { title, detail?, text } (PublicFlowStep) ; `detail` est la ligne sous le
 *   titre (15 px, graisse 500), `text` accepte des marqueurs en ligne (PublicRichText).
 * - `note` : encadré en pointillés sous le schéma, précédé d'une flèche retour
 *   (« Au bilan, un temps d'échange… »).
 */
import RichText from './RichText.astro';
import type { PublicFlowStep } from '../../data/publics/types';

export interface Props {
  label: string;
  items: PublicFlowStep[];
  note?: string;
}

const { label, items, note } = Astro.props;
---

<div class="flow m42-reveal" role="list" aria-label={label}>
  {items.map((item, i) => (
    <>
      {i > 0 && (
        <span class="arrow" aria-hidden="true">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            <path d="M4 12h16" />
            <path d="M14 6l6 6-6 6" />
          </svg>
        </span>
      )}
      <div role="listitem" class="step">
        <span aria-hidden="true" class="num">
          {i + 1}
        </span>
        <h3 class="h3">{item.title}</h3>
        {item.detail && <p class="detail">{item.detail}</p>}
        <p class="text">
          <RichText value={item.text} />
        </p>
      </div>
    </>
  ))}
</div>
{note && (
  <div class="note m42-reveal">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class="note-icon"
    >
      <path d="M20 12H4" />
      <path d="M10 6l-6 6 6 6" />
    </svg>
    <span>{note}</span>
  </div>
)}

<style>
  .flow {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: var(--s-4);
  }

  .step {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
  }

  .num {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 40px;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--accent-text);
  }

  .h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  .detail {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--fg-2);
  }

  .text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg-2);
  }

  .arrow {
    flex: none;
    align-self: center;
    display: inline-flex;
    color: var(--fg);
  }

  .note {
    margin-top: var(--s-5);
    padding: var(--s-4) 20px;
    border: 1px dashed var(--control-border);
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-2);
  }

  .note-icon {
    flex: none;
    color: var(--fg);
  }

  /* Les flèches horizontales deviennent verticales sous 640 px */
  @media (max-width: 639px) {
    .arrow {
      transform: rotate(90deg);
    }
  }
</style>
