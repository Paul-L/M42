---
/**
 * Encadré « Qui intervient » sous les étapes (pages « Pour qui ») : texte à gauche,
 * lien fléché à droite. Apparaît au défilement.
 *
 * Props :
 * - `text` : texte de l'encadré (« Qui intervient : … »).
 * - `link` : lien fléché { label, href } (« Parcours et démarche »).
 * Les deux props correspondent à PublicTeamNote (src/data/publics/types.ts) : `<IntervenantsNote {...team} />`.
 */
import ArrowLink from '../ArrowLink.astro';
import type { PublicLink } from '../../data/publics/types';

export interface Props {
  text: string;
  link: PublicLink;
}

const { text, link } = Astro.props;
---

<div class="note m42-reveal">
  <p class="text">{text}</p>
  <ArrowLink href={link.href}>{link.label}</ArrowLink>
</div>

<style>
  .note {
    margin-top: 56px;
    padding: var(--s-5) 28px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
  }

  .text {
    flex: 1 1 420px;
    min-width: 0;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
