---
/**
 * « Ce que … emporte » (pages « Pour qui ») : colonnes par public, chacune avec un H3 et
 * une liste à puces en croix (CrossList). Les éléments acceptent des marqueurs de relecture
 * en ligne, y compris au milieu de la phrase (« La fiche des bons numéros [À PRODUIRE] : 33700… »).
 * Chaque colonne apparaît au défilement.
 *
 * Props :
 * - `columns` : { title, items: PublicRichText[] } (PublicTakeawayGroup, src/data/publics/types.ts).
 */
import CrossList from './CrossList.astro';
import type { PublicTakeawayGroup } from '../../data/publics/types';

export interface Props {
  columns: PublicTakeawayGroup[];
}

const { columns } = Astro.props;
---

<div class="grid">
  {columns.map((col) => (
    <div class="col m42-reveal">
      <h3 class="h3">{col.title}</h3>
      <CrossList items={col.items} />
    </div>
  ))}
</div>

<style>
  .grid {
    margin-top: var(--s-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 40px var(--s-6);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }
</style>
