---
/**
 * Pied de page commun (kit/maquette/22_gabarit.html, bloc c).
 * Le symbole est repris tel quel du gabarit (version simplifiée du logo validé).
 */
import { footerColumns } from '../data/navigation';
import { catalogue, reglages } from '../lib/cms/contenu';

interface Props {
  /** Chemin de la page courante : son lien reçoit aria-current (comme dans la maquette). */
  current?: string | undefined;
}

const { current } = Astro.props;
const { baseline } = await reglages();
// Liens vers une conférence en brouillon : retirés (la page n'existe pas).
const publiees = new Set((await catalogue()).map((c) => c.href));
const colonnes = footerColumns.map((col) => ({
  ...col,
  links: col.links.filter((l) => !/^\/conferences\/[^/]+\/$/.test(l.href) || publiees.has(l.href)),
}));
---

<footer class="ftr m42-night">
  <div class="ftr-inner">
    <div class="ftr-top">
      <div class="ftr-brand">
        <a href="/" class="logo">
          <svg width="40" height="40" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle cx="50" cy="50" r="46" fill="none" stroke="#F2EEE6" stroke-width="2.4"></circle>
            <polyline
              points="27,71 27,29 50,55 73,29 73,71"
              fill="none"
              stroke="#F2EEE6"
              stroke-width="3.6"
              stroke-linejoin="round"
              stroke-linecap="round"
            ></polyline>
            <path
              d="M50 46 C51 54 51 54 59 55 C51 56 51 56 50 64 C49 56 49 56 41 55 C49 54 49 54 50 46 Z"
              fill="#B08D57"
            ></path>
          </svg>
          <span class="logo-m42">M42</span> <span class="logo-guide">Guide</span>
          <span class="sr-only">, retour à l'accueil</span>
        </a>
        <p class="baseline" set:html={baseline} />
      </div>
      <nav aria-label="Plan du site" class="ftr-nav">
        {colonnes.map((col) => (
          <div>
            <p class="col-title">{col.title}</p>
            <ul class="col-list">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="fl"
                    aria-current={current === link.href ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="ftr-bottom">
      <span>Partout en France, en présentiel ou à distance</span>
      <span>© 2026 M42.guide</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--night);
    color: var(--on-night-2);
    border-top: 1px solid var(--night-line);
  }

  .ftr-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 64px var(--gutter-x) 32px;
  }

  .ftr-top {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
  }

  .ftr-brand {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    color: var(--on-night);
    text-decoration: none;
    min-height: var(--target-min);
  }

  .logo-m42 {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 600;
    line-height: 1;
  }

  .logo-guide {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .baseline {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    color: var(--on-night);
  }

  .ftr-nav {
    flex: 3 1 560px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 32px 24px;
  }

  .col-title {
    margin: 0 0 16px;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--on-night-3);
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    line-height: 1.4;
  }

  .fl {
    color: var(--on-night-2);
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color var(--dur-1) var(--ease-out);
  }

  .fl:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
    color: var(--on-night);
  }

  .ftr-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--night-line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-night-3);
  }
</style>
