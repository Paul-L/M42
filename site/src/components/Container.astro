---
/** Conteneur standard : 1240 px de contenu, marges latérales fluides. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['container', className]}>
  <slot />
</div>

<style>
  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
  }
</style>
