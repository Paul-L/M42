---
/**
 * Corps des pages satellites : sommaire « Sur cette page » (collant à partir de 960 px)
 * + mention des auteurs à gauche, article à droite (slot).
 *
 * Props :
 * - `toc` : entrées du sommaire (ancres de la page).
 */
import { routes } from '../../data/routes';
import type { SatTocItem } from '../../data/satellites/types';
import './satellites.css';

interface Props {
  toc: SatTocItem[];
}

const { toc } = Astro.props;
---

<section aria-label="Contenu de la page" class="body">
  <div class="inner">
    <div class="row">
      <aside class="aside">
        <nav aria-labelledby="toc-t">
          <p id="toc-t" class="toc-title">
            Sur cette page
          </p>
          <ol class="toc">
            {toc.map((item) => (
              <li>
                <a href={item.href} class="toc-link m42-cible">
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="authors">
          Conçu et animé par{' '}
          <a href={routes['A-propos.dc.html']} class="sat-inline">
            Clara Peron et Paul Loustaunau
          </a>
        </div>
      </aside>
      <article class="article">
        <slot />
      </article>
    </div>
  </div>
</section>

<style>
  .body {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }

  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s-7) 72px;
  }

  .aside {
    flex: 1 1 220px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  @media (min-width: 960px) {
    .aside {
      position: sticky;
      top: 104px;
    }
  }

  .toc-title {
    margin: 0;
    border-top: 1px solid var(--ink);
    padding-top: var(--s-4);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .toc {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }

  .toc-link {
    display: block;
    padding: var(--s-2) 0 var(--s-2) var(--s-4);
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
    text-underline-offset: 4px;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .toc-link:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--gold);
    color: var(--ink);
    border-left-color: var(--gold);
  }

  .authors {
    border-top: 1px solid var(--line);
    padding-top: var(--s-4);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-3);
  }

  .article {
    flex: 999 1 600px;
    min-width: 0;
  }
</style>
