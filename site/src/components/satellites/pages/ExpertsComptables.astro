---
/**
 * Satellite « secteur » (kit/maquette/Sat-experts-comptables.dc.html).
 * Contenus : src/data/satellites/experts-comptables.ts (objet `page` : sections et blocs typés,
 * rendus ici selon leur `type` ; les notes internes de la maquette,
 * « NE PAS PUBLIER », y sont reprises en commentaire de code, jamais dans le HTML).
 * JSON-LD : WebPage + BreadcrumbList + FAQPage (questions sans marqueur seulement,
 * DECISIONS.md point 19 ; src/data/satellites/json-ld.ts).
 * Aucun lien d'en-tête marqué dans la maquette : pas de `current`.
 * Pas de logique interactive (renderVals() vide) ; la FAQ est en <details> natif.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SatHero from '../../../components/satellites/SatHero.astro';
import SatBody from '../../../components/satellites/SatBody.astro';
import SatSection from '../../../components/satellites/SatSection.astro';
import SatText from '../../../components/satellites/SatText.astro';
import SatFigures from '../../../components/satellites/SatFigures.astro';
import SatNote from '../../../components/satellites/SatNote.astro';
import SatPullQuote from '../../../components/satellites/SatPullQuote.astro';
import SatNumbered from '../../../components/satellites/SatNumbered.astro';
import SatTable from '../../../components/satellites/SatTable.astro';
import SatMinor from '../../../components/satellites/SatMinor.astro';
import SatMore from '../../../components/satellites/SatMore.astro';
import SatDraftBlock from '../../../components/satellites/SatDraftBlock.astro';
import SatFaq from '../../../components/satellites/SatFaq.astro';
import SatLinkList from '../../../components/satellites/SatLinkList.astro';
import SatSources from '../../../components/satellites/SatSources.astro';
import SatCta from '../../../components/satellites/SatCta.astro';
import { satellitePageJsonLdOf } from '../../../data/satellites/json-ld';
import type { Pages } from '../../../lib/cms/registre';

const { page } = Astro.props as { page: Pages['conference-ia-experts-comptables'] };

const { seo, crumbs, hero, toc, sections, sources, cta } = page;
const jsonLd = satellitePageJsonLdOf(page);

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <SatHero
    crumbs={crumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    lead={hero.lead}
    size="lg"
    measure="22ch"
    primary={hero.primary}
    secondary={hero.secondary}
  >
    <div slot="aside" class="audiences">
      <p class="audiences-label">{hero.audiences.label}</p>
      <ul class="audiences-list">
        {hero.audiences.items.map((item) => (
          <li>
            <p class="audiences-title">{item.title}</p>
            <p class="audiences-detail">{item.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </SatHero>

  <SatBody toc={toc}>
    {sections.map((section, i) => {
      // Section « minor » (Qui intervient) : paragraphe et lien plus serrés.
      const minor = section.kind === 'minor';
      const blocks = section.blocks.map((block) => {
        switch (block.type) {
          case 'text':
            return minor ? (
              <p class="speakers">{block.text}</p>
            ) : (
              <SatText variant={block.variant}>
                {block.html !== undefined ? <Fragment set:html={block.html} /> : block.text}
              </SatText>
            );
          case 'figures':
            return <SatFigures items={block.items} />;
          case 'note':
            return <SatNote label={block.label}>{block.text}</SatNote>;
          case 'quote':
            return <SatPullQuote>{block.text}</SatPullQuote>;
          case 'numbered':
            return <SatNumbered items={block.items} />;
          case 'table':
            return <SatTable table={block.table} />;
          case 'highlights':
            return (
              <ul class="takeaways">
                {block.items.map((item, n) => (
                  <li>
                    <span aria-hidden="true" class="takeaway-num">
                      {pad(n + 1)}
                    </span>
                    <p class="takeaway-text">
                      <strong>{item.strong}</strong>
                      {item.rest}
                    </p>
                  </li>
                ))}
              </ul>
            );
          case 'more':
            return (
              <SatMore href={block.href} spacing={minor ? 'sm' : 'md'}>
                {block.label}
              </SatMore>
            );
          case 'draft':
            return <SatDraftBlock>{block.text}</SatDraftBlock>;
          case 'faq':
            return <SatFaq items={block.items} />;
          case 'links':
            return <SatLinkList items={block.items} />;
          default:
            throw new Error(`Bloc non pris en charge sur cette page : ${block.type}`);
        }
      });
      return minor ? (
        <SatMinor id={section.id} headingId={`${section.id}-t`} title={section.title} spacing="lg">
          {blocks}
        </SatMinor>
      ) : (
        <SatSection
          id={section.id}
          eyebrow={section.eyebrow ?? ''}
          title={section.title}
          first={i === 0}
        >
          {blocks}
        </SatSection>
      );
    })}

    <SatSources items={sources.items} />
  </SatBody>

  <SatCta
    eyebrow={cta.eyebrow}
    title={cta.title}
    lead={cta.lead}
    primary={cta.primary}
    secondary={cta.secondary}
  />
</BaseLayout>

<style>
  /* Encadré « Trois publics, un même cadre » (colonne droite de l'en-tête) */
  .audiences {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    padding: 28px 26px;
  }

  .audiences-label {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .audiences-list {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .audiences-list li {
    border-top: 1px solid var(--line);
    padding: 14px 0;
  }

  .audiences-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .audiences-detail {
    margin: 2px 0 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-3);
  }

  /* Ce que vos équipes emportent */
  .takeaways {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--s-4);
  }

  .takeaways li {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5) 22px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .takeaway-num {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--gold-deep);
  }

  .takeaway-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .takeaway-text strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* Qui intervient */
  .speakers {
    margin: var(--s-3) 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
