---
/**
 * Politique de confidentialité — kit/maquette/Confidentialite.dc.html
 * Aucune logique interactive dans la maquette (seul l'interrupteur d'animations de l'éditeur,
 * sans effet ici : la page n'a pas d'apparition au défilement).
 * Textes : src/data/legal/confidentialite.ts. La page ne garde que la structure.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LegalProse from '../../components/legal/LegalProse.astro';
import LegalBlocks from '../../components/legal/LegalBlocks.astro';
import { page as lirePage } from '../../lib/cms/contenu';

const { breadcrumb, enBref, intro, proseLabel, sections, seo } = await lirePage('confidentialite');

const pageUrl = new URL('/confidentialite/', Astro.site).href;
const homeUrl = new URL('/', Astro.site).href;

const toc = sections.map(({ id, title }) => ({ id, label: title }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: seo.title,
      description: seo.description,
      isPartOf: { '@id': `${homeUrl}#site` },
      breadcrumb: { '@id': `${pageUrl}#ariane` },
      inLanguage: 'fr-FR',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#ariane`,
      itemListElement: breadcrumb.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        ...(crumb.href ? { item: new URL(crumb.href, Astro.site).href } : {}),
      })),
    },
  ],
};
---

<BaseLayout footerCurrent title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- En-tête de page -->
  <section aria-labelledby="titre-conf">
    <div class="intro">
      <Breadcrumb items={breadcrumb} />
      <h1 id="titre-conf" class="h1">
        <span class="h1-eyebrow">{intro.over}</span>
        <span class="h1-title">{intro.title}</span>
      </h1>
      <p class="lead" set:html={intro.lead} />
      <p class="updated">{intro.updated}</p>

      <!-- En bref -->
      <div class="brief">
        <h2 class="brief-title">{enBref.title}</h2>
        <ul class="brief-list">
          {enBref.items.map((item) => (
            <li>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
                class="brief-icon"
              >
                <path d="M12 3v18" />
                <path d="M3 12h18" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Corps : sommaire + sections -->
  <LegalProse label={proseLabel} toc={toc}>
    {sections.map((section, i) => (
      <section id={section.id} aria-labelledby={section.headingId} class="legal-section">
        <h2 id={section.headingId} class="legal-h2">
          <span aria-hidden="true" class="legal-num">
            {i + 1}
          </span>
          <Fragment set:html={section.title} />
        </h2>
        <LegalBlocks blocks={section.blocks} />
      </section>
    ))}
  </LegalProse>
</BaseLayout>

<style>
  .intro {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3rem) var(--gutter-x) clamp(2.5rem, 5vw, 4rem);
  }

  .h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-weight: 400;
  }

  .h1-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .h1-title {
    max-width: var(--measure-h1);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tracking-h1);
    color: var(--fg);
  }

  .lead {
    margin: 32px 0 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--fg-2);
  }

  /* Maquette : « margin: 16px 0 0; margin: 0 » ; la seconde déclaration l'emporte. */
  .updated {
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--fg-3);
  }

  .brief {
    margin-top: 48px;
    max-width: 52rem;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .brief-title {
    margin: 0;
    font-size: var(--fs-faq);
    font-weight: 600;
    line-height: 1.35;
  }

  .brief-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--fg-2);
  }

  .brief-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .brief-icon {
    flex: none;
    color: var(--fg);
  }

  .cnil-address {
    margin: 0;
    font-size: 16px;
    line-height: var(--lh-body);
    color: var(--fg);
  }
</style>
