---
/**
 * Satellite « événement » (kit/maquette/Sat-seminaire-entreprise.dc.html).
 * Contenus : src/data/satellites/seminaire-entreprise.ts (objet `page` : sections et blocs typés,
 * rendus ici bloc par bloc selon leur `type`).
 * JSON-LD : WebPage + BreadcrumbList + FAQPage (questions sans marqueur seulement,
 * DECISIONS.md point 19 ; src/data/satellites/json-ld.ts).
 * Aucun lien d'en-tête marqué dans la maquette : pas de `current`.
 * Pas de logique interactive (renderVals() vide) ; la FAQ est en <details> natif.
 * L'ancre #cinq-questions est appelée depuis la page Repères : ne pas la renommer.
 *
 * Maillage SEO (commentaire de la maquette) : « Voir clair dans l'IA » est un format de
 * /conferences/ia-au-quotidien/ (11_architecture_seo, 1.3) : pas de page dédiée. Les sujets du
 * tableau (Garder la main, Déléguer sans abdiquer…) n'ont pas de page en v1 : pas de lien.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import SatHero from '../../components/satellites/SatHero.astro';
import SatBody from '../../components/satellites/SatBody.astro';
import SatSection from '../../components/satellites/SatSection.astro';
import SatText from '../../components/satellites/SatText.astro';
import SatFigures from '../../components/satellites/SatFigures.astro';
import SatBox from '../../components/satellites/SatBox.astro';
import SatPullQuote from '../../components/satellites/SatPullQuote.astro';
import SatNumbered from '../../components/satellites/SatNumbered.astro';
import SatNote from '../../components/satellites/SatNote.astro';
import SatMore from '../../components/satellites/SatMore.astro';
import SatTable from '../../components/satellites/SatTable.astro';
import SatDefList from '../../components/satellites/SatDefList.astro';
import SatDraftBlock from '../../components/satellites/SatDraftBlock.astro';
import SatFaq from '../../components/satellites/SatFaq.astro';
import SatLinkList from '../../components/satellites/SatLinkList.astro';
import SatSources from '../../components/satellites/SatSources.astro';
import SatCta from '../../components/satellites/SatCta.astro';
import { satellitePageJsonLdOf } from '../../data/satellites/json-ld';
import { page } from '../../data/satellites/seminaire-entreprise';

const { seo, crumbs, hero, toc, sections, sources, cta } = page;
const jsonLd = satellitePageJsonLdOf(page);
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <SatHero
    crumbs={crumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    lead={hero.lead}
    size="xl"
    measure="20ch"
    note={hero.note}
    primary={hero.primary}
    secondary={hero.secondary}
  >
    <Placeholder slot="aside" label={hero.photo} ratio="3/2" />
  </SatHero>

  <SatBody toc={toc}>
    {sections.map((section, i) => (
      <SatSection
        id={section.id}
        eyebrow={section.eyebrow ?? ''}
        title={section.title}
        first={i === 0}
      >
        {section.blocks.map((block) => {
          switch (block.type) {
            case 'text':
              return (
                <SatText variant={block.variant}>
                  {block.html !== undefined ? <Fragment set:html={block.html} /> : block.text}
                </SatText>
              );
            case 'figures':
              return <SatFigures items={block.items} />;
            case 'box':
              return (
                <SatBox label={block.label}>
                  {(block.paragraphs ?? []).map((p) => (
                    <SatText variant={p.variant}>
                      {p.html !== undefined ? <Fragment set:html={p.html} /> : p.text}
                    </SatText>
                  ))}
                </SatBox>
              );
            case 'quote':
              return <SatPullQuote>{block.text}</SatPullQuote>;
            case 'numbered':
              return <SatNumbered items={block.items} />;
            case 'note':
              return <SatNote label={block.label}>{block.text}</SatNote>;
            case 'more':
              return <SatMore href={block.href}>{block.label}</SatMore>;
            case 'table':
              return <SatTable table={block.table} />;
            case 'definitions':
              return <SatDefList items={block.items} />;
            case 'video':
              return (
                <div class="video">
                  <Placeholder label={block.label} ratio="16/9" />
                </div>
              );
            case 'draft':
              return <SatDraftBlock>{block.text}</SatDraftBlock>;
            case 'faq':
              return <SatFaq items={block.items} />;
            case 'links':
              return <SatLinkList items={block.items} />;
            default:
              throw new Error(`Bloc non pris en charge sur cette page : ${block.type}`);
          }
        })}
      </SatSection>
    ))}

    <SatSources items={sources.items} />
  </SatBody>

  <SatCta
    eyebrow={cta.eyebrow}
    title={cta.title}
    lead={cta.lead}
    primary={cta.primary}
    secondary={cta.secondary}
  />
</BaseLayout>

<style>
  .video {
    margin-top: 40px;
  }
</style>
