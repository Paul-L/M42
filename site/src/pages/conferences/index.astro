---
/**
 * Index des conférences (kit/maquette/Conferences.dc.html → /conferences/).
 * Contenus : src/data/conferences-index.ts (identité des 4 conférences : conferences/catalogue.ts).
 * JSON-LD : CollectionPage + BreadcrumbList + ItemList des 4 Service par @id.
 * Aucun îlot : la page n'a pas de logique interactive (apparitions au défilement en CSS,
 * FAQ en <details>). « Sur mesure » est une section (#sur-mesure), pas une page.
 * Les 5 conférences entreprise « sur demande » ne sont pas listées ici (simple renvoi vers
 * /entreprises/ dans la section Sur mesure).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexHero from '../../components/conferences-index/IndexHero.astro';
import ConferenceCatalogue from '../../components/conferences-index/ConferenceCatalogue.astro';
import FormatsOverview from '../../components/conferences-index/FormatsOverview.astro';
import HowItWorks from '../../components/conferences-index/HowItWorks.astro';
import CustomTalk from '../../components/conferences-index/CustomTalk.astro';
import ConferenceAudiences from '../../components/conferences/ConferenceAudiences.astro';
import ConferenceFaq from '../../components/conferences/ConferenceFaq.astro';
import ConferenceCta from '../../components/conferences/ConferenceCta.astro';

import { routes } from '../../data/routes';
import { catalogue as lireCatalogue, page as lirePage } from '../../lib/cms/contenu';

const {
  ariane,
  detailsConferences: _details,
  catalogueSection,
  contact,
  deroulement,
  faq,
  formats,
  formatsDetailles,
  hero,
  pourQui,
  seo,
  surMesure,
} = await lirePage('conferences');
const cartes = (await lireCatalogue()).map((c) => {
  const d = _details[c.slug as keyof typeof _details];
  if (!d) throw new Error(`détails manquants : ${c.slug}`);
  return { ...c, ...d };
});

const coupDoeil = [
  ...cartes.map((c) => ({
    numero: c.numero,
    label: c.titre,
    note: c.signature ? hero.coupDoeil.noteSignature : undefined,
    href: `#conf-${c.slug}`,
  })),
  hero.coupDoeil.surMesure,
];

/*
 * JSON-LD (commentaire SEO de la maquette) : CollectionPage (sous-type de WebPage) + BreadcrumbList
 * + ItemList des 4 Service, référencés par leur @id (déclarés en entier sur chaque page conférence).
 * Aucun nom d'employeur ni structure de facturation ; aucun marqueur [À …].
 */
const SITE = 'https://m42.guide';
const URL_PAGE = `${SITE}${routes['Conferences.dc.html']}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${URL_PAGE}#page`,
      url: URL_PAGE,
      name: seo.title,
      description: seo.description,
      isPartOf: { '@id': `${SITE}/#site` },
      breadcrumb: { '@id': `${URL_PAGE}#ariane` },
      mainEntity: { '@id': `${URL_PAGE}#conferences` },
      inLanguage: 'fr-FR',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${URL_PAGE}#ariane`,
      itemListElement: ariane.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: a.label,
        ...(a.href ? { item: new URL(a.href, SITE).href } : {}),
      })),
    },
    {
      '@type': 'ItemList',
      '@id': `${URL_PAGE}#conferences`,
      name: catalogueSection.titre,
      numberOfItems: cartes.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: cartes.map((c, i) => {
        const url = new URL(c.href, SITE).href;
        return {
          '@type': 'ListItem',
          position: i + 1,
          name: c.titre,
          url,
          item: { '@id': `${url}#service` },
        };
      }),
    },
  ],
};
---

<BaseLayout title={seo.title} description={seo.description} current="conferences" jsonLd={jsonLd}>
  <IndexHero
    ariane={ariane}
    surTitre={hero.surTitre}
    titre={hero.titre}
    chapo={hero.chapo}
    ctaPrincipal={hero.ctaPrincipal}
    ctaSecondaire={hero.ctaSecondaire}
    nav={{ label: hero.coupDoeil.label, surTitre: hero.coupDoeil.surTitre, items: coupDoeil }}
  />

  <ConferenceCatalogue
    surTitre={catalogueSection.surTitre}
    titre={catalogueSection.titre}
    chapo={catalogueSection.chapo}
    cartes={cartes}
    formats={formatsDetailles}
    cta={catalogueSection.ctaCarte}
    badge={catalogueSection.badgeSignature}
  />

  <FormatsOverview
    surTitre={formats.surTitre}
    titre={formats.titre}
    chapo={formats.chapo}
    items={formats.items}
    choix={formats.choix}
  />

  <HowItWorks surTitre={deroulement.surTitre} titre={deroulement.titre} items={deroulement.items} />

  <CustomTalk
    surTitre={surMesure.surTitre}
    titre={surMesure.titre}
    chapo={surMesure.chapo}
    renvoiAvant={surMesure.renvoiAvant}
    renvoi={surMesure.renvoi}
    cta={surMesure.cta}
  />

  <ConferenceAudiences titre={pourQui.titre} chapo={pourQui.chapo} items={pourQui.items} />

  <ConferenceFaq titre={faq.titre} items={faq.items} />

  <ConferenceCta titre={contact.titre} chapo={contact.chapo} cta={contact.cta} />
</BaseLayout>
