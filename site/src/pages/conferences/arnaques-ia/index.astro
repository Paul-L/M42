---
/**
 * Conférence II « Arnaques 2026 » (kit/maquette/Conf-arnaques-ia.dc.html).
 * Contenus : src/data/conferences/arnaques-ia.ts. JSON-LD : WebPage + BreadcrumbList + Service
 * + FAQPage (src/data/conferences/jsonld.ts).
 * Îlots : animation au défilement « Anatomie d'un faux SMS » (ScrollStory + visuel FauxSms),
 * jeu « Arnaque ou pas ? » (ArnaqueOuPasGame). FAQ en <details> sans JavaScript.
 *
 * Pas de `current` (DECISIONS.md, point 3). La maquette met pourtant aria-current="true"
 * (rubrique, soulignement or) sur « Conférences » : option absente de l'en-tête partagé.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConferenceHero from '../../../components/conferences/ConferenceHero.astro';
import ScrollStory from '../../../components/conferences/ScrollStory.astro';
import FauxSms from '../../../components/conferences/visuels/FauxSms.astro';
import ConferenceObjectives from '../../../components/conferences/ConferenceObjectives.astro';
import KeyFigures from '../../../components/conferences/KeyFigures.astro';
import ConferenceProgram from '../../../components/conferences/ConferenceProgram.astro';
import TempsFort from '../../../components/conferences/TempsFort.astro';
import ArnaqueOuPasGame from '../../../components/conferences/ArnaqueOuPasGame.astro';
import ConferenceFormats from '../../../components/conferences/ConferenceFormats.astro';
import ConferenceAudiences from '../../../components/conferences/ConferenceAudiences.astro';
import HelpNumbers from '../../../components/conferences/HelpNumbers.astro';
import ConferenceFaq from '../../../components/conferences/ConferenceFaq.astro';
import OtherConferences from '../../../components/conferences/OtherConferences.astro';
import ConferenceCta from '../../../components/conferences/ConferenceCta.astro';
import { arnaquesIa as conf } from '../../../data/conferences/arnaques-ia';
import { conferenceJsonLd } from '../../../data/conferences/jsonld';

const visuel = conf.demonstration.visuel;
---

<BaseLayout
  section="conferences"
  title={conf.seo.title}
  description={conf.seo.description}
  jsonLd={conferenceJsonLd(conf)}
>
  <ConferenceHero
    titre={conf.titre}
    surTitre={conf.surTitre}
    noteTitre={conf.noteTitre}
    sousTitre={conf.sousTitre}
    promesse={conf.promesse}
    ctaSecondaire={conf.ctaSecondaire}
    miseAJour={conf.miseAJour}
    fiche={conf.fiche}
  />

  <ScrollStory
    label={conf.demonstration.label}
    surTitre={conf.demonstration.surTitre}
    etapes={conf.demonstration.etapes}
    k={conf.demonstration.k}
    visualSize="phone"
  >
    {visuel?.type === 'faux-sms' && <FauxSms slot="visual" visuel={visuel} />}
  </ScrollStory>

  <ConferenceObjectives
    titre={conf.objectifs.titre}
    enClair={conf.enClair}
    items={conf.objectifs.items}
  />

  {conf.chiffres && <KeyFigures label={conf.chiffres.label} items={conf.chiffres.items} />}

  <ConferenceProgram
    surTitre={conf.programme.surTitre}
    titre={conf.programme.titre}
    chapo={conf.programme.chapo}
    blocs={conf.programme.blocs}
  />

  <TempsFort
    id={conf.tempsFort.id}
    titre={conf.tempsFort.titre}
    chapo={conf.tempsFort.chapo}
    note={conf.tempsFort.note}
  >
    {conf.jeu && <ArnaqueOuPasGame messages={conf.jeu} />}
  </TempsFort>

  <ConferenceFormats titre={conf.formats.titre} items={conf.formats.items} />

  <ConferenceAudiences
    titre={conf.publics.titre}
    chapo={conf.publics.chapo}
    items={conf.publics.items}
    declinaison={conf.declinaisonEntreprise}
  />

  {conf.numeros && (
    <HelpNumbers
      surTitre={conf.numeros.surTitre}
      titre={conf.numeros.titre}
      items={conf.numeros.items}
    />
  )}

  <ConferenceFaq titre={conf.faq.titre} items={conf.faq.items} sources={conf.faq.sources} />

  <OtherConferences current={conf.slug} />

  <ConferenceCta titre={conf.contact.titre} chapo={conf.contact.chapo} cta={conf.contact.cta} />
</BaseLayout>
