    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: var(--s-5);
  }

  /* Démo du gabarit : le portrait nuit est posé sur le fond clair, comme dans la maquette */
  .night-sample {
    background: transparent;
  }

  .night-sample :global(.portrait) {
    margin-top: 24px;
    max-width: 320px;
  }

  .quote-wrap,
  .faq-wrap {
    margin-top: 64px;
  }

  .form {
    margin-top: 64px;
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .k-h3 {
    margin: 48px 0 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  /* Partie 3 : composants de famille */
  .k-h2 {
    margin: 0;
    max-width: var(--measure-h2);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--tracking-h2);
  }

  .k-h3--flush {
    margin-top: 0;
  }

  .k-desc {
    margin: 8px 0 0;
    max-width: var(--measure-text);
    font-size: var(--fs-small);
    color: var(--fg-3);
  }

  .k-text {
    margin: 24px 0 0;
    max-width: var(--measure-text);
    color: var(--fg-2);
  }

  .k-block {
    margin-top: 24px;
  }

  .k-row,
  .k-grid {
    margin-top: 24px;
  }

  .k-narrow {
    max-width: 32rem;
  }

  .k-stack {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .k-article {
    max-width: 46rem;
  }

  .k-capture {
    max-width: 40rem;
  }

  .k-sky {
    display: flex;
    justify-content: center;
  }

  .k-h1-sample {
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .k-h1-main {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
  }

  .k-note-box {
    margin-top: 48px;
    max-width: var(--measure-text);
    border: 1px dashed var(--rule);
    padding: 16px 20px;
  }

  .k-note-title {
    margin: 0;
    font-weight: 600;
  }

  .k-list {
    margin: 8px 0 0;
    padding-left: 1.25rem;
    color: var(--fg-2);
  }

  .k-list li + li {
    margin-top: 8px;
  }

  :global(.k-band-label) {
    padding-top: var(--s-6);
    padding-bottom: var(--s-4);
  }
</style>
