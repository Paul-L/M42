---
/**
 * Éducation (kit/maquette/Education.dc.html) : établissements scolaires et familles.
 * Contenus : src/data/publics/education.ts (futur enregistrement Directus `publics`).
 * SEO : canonical /education/, H1 « Apprendre avec l'IA, pas à sa place. » + introduction
 * avec les mots-clés (intervention IA collège / lycée, éducation aux médias).
 * JSON-LD : WebPage + BreadcrumbList + Service + FAQPage (questions sans marqueur seulement,
 * DECISIONS.md point 19 ; components/publics/json-ld.ts).
 * En-tête : « Écoles » marqué comme page courante (DECISIONS.md, point 3).
 * Aucune logique interactive (la classe Component de la maquette est vide) ; la FAQ est en <details>.
 *
 * [SI RÉFÉRENCEMENT ADAGE OBTENU] : question pass Culture prête dans src/data/publics/education.ts
 * (interrupteur ADAGE_REFERENCE). Tant qu'il vaut false, elle n'est ni affichée ni balisée, et la
 * note de relecture de la maquette reste visible.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import CtaBand from '../../components/CtaBand.astro';
import PublicHero from '../../components/publics/PublicHero.astro';
import PublicSectionHead from '../../components/publics/PublicSectionHead.astro';
import IssueGrid from '../../components/publics/IssueGrid.astro';
import EducationAudiences from '../../components/publics/EducationAudiences.astro';
import PublicFormats from '../../components/publics/PublicFormats.astro';
import PublicConferenceGrid from '../../components/publics/PublicConferenceGrid.astro';
import TopicList from '../../components/publics/TopicList.astro';
import TakeawayColumns from '../../components/publics/TakeawayColumns.astro';
import StepList from '../../components/publics/StepList.astro';
import IntervenantsNote from '../../components/publics/IntervenantsNote.astro';
import PublicFaq from '../../components/publics/PublicFaq.astro';
import { publicPageJsonLd } from '../../components/publics/json-ld';
import { ADAGE_REFERENCE, education as page } from '../../data/publics/education';

const { title, description } = page.seo;

const faqItems = ADAGE_REFERENCE ? [...page.faq.items, page.faq.passCulture] : page.faq.items;

const jsonLd = publicPageJsonLd({
  path: '/education/',
  title,
  description,
  crumb: page.hero.crumb,
  service: {
    name: "Interventions sur l'IA pour les collèges, les lycées et les parents",
    serviceType: "Intervention de sensibilisation à l'intelligence artificielle",
    description: [page.hero.lead, ...page.hero.paragraphs].join(' '),
    audience: [
      { '@type': 'EducationalAudience', educationalRole: 'student', audienceType: 'Élèves' },
      { '@type': 'EducationalAudience', educationalRole: 'teacher', audienceType: 'Enseignants' },
      { '@type': 'EducationalAudience', educationalRole: 'parent', audienceType: 'Parents' },
    ],
    about: [
      { '@type': 'Thing', name: 'Intelligence artificielle' },
      { '@type': 'Thing', name: 'Éducation aux médias' },
      { '@type': 'Thing', name: 'Esprit critique' },
      { '@type': 'Thing', name: 'Cyberharcèlement' },
    ],
  },
  faq: faqItems,
});
---

<BaseLayout title={title} description={description} current="education" jsonLd={jsonLd}>
  <PublicHero {...page.hero} />

  <Section id="enjeux" labelledby="titre-enjeux">
    <PublicSectionHead id="titre-enjeux" eyebrow={page.stakes.eyebrow}>
      {page.stakes.title}
    </PublicSectionHead>
    <IssueGrid items={page.stakes.items} />
  </Section>

  <Section id="publics" labelledby="titre-publics" tone="sunk">
    <PublicSectionHead
      id="titre-publics"
      eyebrow={page.audiences.eyebrow}
      lead={page.audiences.lead}
    >
      {page.audiences.title}
    </PublicSectionHead>
    <EducationAudiences items={page.audiences.items} />
  </Section>

  <Section id="formats" labelledby="titre-formats">
    <PublicSectionHead id="titre-formats" eyebrow={page.formats.eyebrow} lead={page.formats.lead}>
      {page.formats.title}
    </PublicSectionHead>
    <PublicFormats items={page.formats.items} footnote={page.formats.note} />
  </Section>

  <Section id="sujets" labelledby="titre-sujets" tone="sunk">
    <PublicSectionHead
      id="titre-sujets"
      eyebrow={page.conferences.eyebrow}
      lead={page.conferences.lead}
    >
      {page.conferences.title}
    </PublicSectionHead>
    <PublicConferenceGrid items={page.conferences.items} />
    <TopicList title={page.conferences.otherTitle} items={page.conferences.others} />
    <div class="more">
      <ArrowLink href={page.conferences.link.href}>{page.conferences.link.label}</ArrowLink>
    </div>
  </Section>

  <Section id="emportent" labelledby="titre-emportent">
    <PublicSectionHead id="titre-emportent" eyebrow={page.takeaways.eyebrow}>
      {page.takeaways.title}
    </PublicSectionHead>
    <TakeawayColumns columns={page.takeaways.groups} />
  </Section>

  <Section id="etapes" labelledby="titre-etapes" tone="sunk">
    <PublicSectionHead id="titre-etapes" eyebrow={page.steps.eyebrow}>
      {page.steps.title}
    </PublicSectionHead>
    <StepList items={page.steps.items} />
    <IntervenantsNote {...page.steps.team} />
  </Section>

  <Section id="faq" labelledby="titre-faq">
    <PublicSectionHead id="titre-faq" eyebrow={page.faq.eyebrow}>
      {page.faq.title}
    </PublicSectionHead>
    <PublicFaq items={faqItems} />
    {!ADAGE_REFERENCE && <p class="review-note m42-reveal">{page.faq.reviewNote}</p>}
  </Section>

  <CtaBand id="titre-contact" {...page.cta} />
</BaseLayout>

<style>
  .more {
    margin-top: var(--s-6);
    display: flex;
  }

  .review-note {
    margin: var(--s-5) 0 0;
    max-width: 52rem;
    padding: var(--s-3) var(--s-4);
    border: 1px dashed var(--line-strong);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }
</style>
