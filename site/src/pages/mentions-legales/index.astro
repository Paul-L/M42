---
/**
 * Mentions légales (kit/maquette/Mentions-legales.dc.html).
 * SEO : title « Mentions légales | M42 », description ajoutée (DECISIONS.md, point 41), canonical /mentions-legales/.
 * JSON-LD : WebPage + BreadcrumbList uniquement, aucune dénomination sociale
 * tant que l'entité éditrice n'est pas tranchée (05, décision n° 6).
 * Textes : src/data/legal/mentions-legales.ts. La page ne garde que la structure.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LegalProse from '../../components/legal/LegalProse.astro';
import LegalBlocks from '../../components/legal/LegalBlocks.astro';
import { page as lirePage } from '../../lib/cms/contenu';

const { breadcrumb, decide, intro, proseLabel, sections, seo } = await lirePage('mentions-legales');

const url = 'https://m42.guide/mentions-legales/';

const toc = sections.map(({ id, title }) => ({ id, label: title }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#page`,
      url,
      name: seo.title,
      isPartOf: { '@id': 'https://m42.guide/#site' },
      breadcrumb: { '@id': `${url}#ariane` },
      inLanguage: 'fr-FR',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#ariane`,
      itemListElement: breadcrumb.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        ...(crumb.href ? { item: new URL(crumb.href, url).href } : {}),
      })),
    },
  ],
};
---

<BaseLayout footerCurrent title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- En-tête de page -->
  <section aria-labelledby="titre-ml">
    <div class="intro">
      <Breadcrumb items={breadcrumb} />
      <h1 id="titre-ml" class="h1">
        <span class="h1-over">{intro.over}</span>
        <span class="h1-title">{intro.title}</span>
      </h1>
      <p class="lead" set:html={intro.lead} />
      <p class="updated">{intro.updated}</p>

      {/* ENCADRÉ À DÉCIDER : entité éditrice. Ne nommer AUCUNE société ici tant que la décision n'est pas prise. */}
      <aside aria-labelledby="titre-decider" class="decide">
        <p class="decide-over">{decide.over}</p>
        <h2 id="titre-decider" class="decide-title" set:html={decide.title} />
        {decide.paragraphs.map((p) => (
          <p class="decide-text" set:html={p} />
        ))}
      </aside>
    </div>
  </section>

  <!-- Corps : sommaire + sections -->
  <LegalProse label={proseLabel} toc={toc}>
    {sections.map((section, i) => (
      <section id={section.id} class="legal-section" aria-labelledby={section.headingId}>
        <h2 class="legal-h2" id={section.headingId}>
          <span class="legal-num" aria-hidden="true">
            {i + 1}
          </span>
          <Fragment set:html={section.title} />
        </h2>
        <LegalBlocks blocks={section.blocks} />
      </section>
    ))}
  </LegalProse>
</BaseLayout>

<style>
  .intro {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3rem) var(--gutter-x) clamp(2.5rem, 5vw, 4rem);
  }

  .h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    font-weight: 400;
  }

  .h1-over {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .h1-title {
    max-width: var(--measure-h1);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tracking-h1);
    color: var(--fg);
  }

  .lead {
    margin: var(--s-6) 0 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--fg-2);
  }

  /* Maquette : « margin: 16px 0 0; margin: 0 » → la seconde déclaration l'emporte */
  .updated {
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--fg-3);
  }

  /* Encadré « À décider » */
  .decide {
    margin-top: var(--s-7);
    max-width: 52rem;
    border: 1px solid var(--gold-deep);
    border-left: 4px solid var(--gold);
    background: var(--surface-raised);
    padding: var(--s-5) 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .decide-over {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .decide-title {
    margin: 0;
    font-size: var(--fs-faq);
    font-weight: 600;
    line-height: 1.35;
  }

  .decide-text {
    margin: 0;
    max-width: var(--measure-text);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg-2);
    hyphens: auto;
  }
</style>
