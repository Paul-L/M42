---
/**
 * À propos (kit/maquette/A-propos.dc.html) : Clara Peron et Paul Loustaunau.
 * Clara toujours avant Paul (textes, photos, JSON-LD).
 * SEO : canonical /a-propos/, H1 « Clara Peron et Paul Loustaunau » avec le sur-titre
 * « À propos de M42 » dans le même H1, ancres stables #clara-peron et #paul-loustaunau.
 * JSON-LD : AboutPage + BreadcrumbList + Person ×2 (11_architecture_seo.md, § 3.3).
 * Aucun employeur, aucune structure de facturation, pas de worksFor.
 * Aucune logique interactive : la classe de la maquette (m42-anim / m42-still) n'est
 * qu'une option d'éditeur ; le mouvement réduit est géré par la feuille globale.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Placeholder from '../../components/Placeholder.astro';
import Section from '../../components/Section.astro';
import ApproachSymbol from '../../components/a-propos/ApproachSymbol.astro';
import IntervenantProfile from '../../components/a-propos/IntervenantProfile.astro';
import AboutCta from '../../components/a-propos/AboutCta.astro';
import { routes } from '../../data/routes';
import { slotText } from '../../lib/slot-text';
import { intervenants, personId, personSchema } from '../../data/intervenants';
import {
  approach,
  approachSection,
  cta,
  duo,
  facts,
  hero,
  limits,
  limitsSection,
  onThisPage,
  principles,
  principlesSection,
  seo,
} from '../../data/a-propos';

const url = 'https://m42.guide/a-propos/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${url}#page`,
      url,
      name: seo.title,
      isPartOf: { '@id': 'https://m42.guide/#site' },
      about: { '@id': 'https://m42.guide/#organisation' },
      breadcrumb: { '@id': `${url}#ariane` },
      mainEntity: intervenants.map((i) => ({ '@id': personId(i.slug) })),
      inLanguage: 'fr-FR',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#ariane`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://m42.guide/' },
        { '@type': 'ListItem', position: 2, name: hero.crumb },
      ],
    },
    ...intervenants.map(personSchema),
  ],
};
---

<BaseLayout title={seo.title} description={seo.description} footerCurrent jsonLd={jsonLd}>
  <!-- En-tête de page : aucune animation d'entrée sur le H1 et le chapô -->
  <section aria-labelledby="titre-apropos">
    <Container class="page-head">
      <Breadcrumb
        items={[{ label: 'Accueil', href: routes['Main.dc.html'] }, { label: hero.crumb }]}
      />
      <div class="head-row">
        <div class="head-text">
          <h1 id="titre-apropos" class="h1">
            <Eyebrow as="span" rule={false}>
              <Fragment set:html={slotText(hero.eyebrow, 12)} />
            </Eyebrow>
            <span class="h1-main">{hero.title}</span>
          </h1>
          <p class="intro" set:html={hero.intro} />
          <ul class="facts">
            {facts.map((f) => (
              <li>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                  focusable="false"
                  class="plus"
                >
                  <path d="M12 3v18" />
                  <path d="M3 12h18" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
        <div class="head-photo">
          <Placeholder label={hero.photo} ratio="3/2" />
        </div>
      </div>
      <nav aria-label="Sur cette page" class="toc">
        <span class="toc-label">Sur cette page :</span>
        {onThisPage.map((l) => (
          <a href={l.href} class="toc-link">
            {l.label}
          </a>
        ))}
      </nav>
    </Container>
  </section>

  <!-- Notre démarche (section nuit) : le nom, la nébuleuse d'Orion, « se repérer », le duo -->
  <Section id="demarche" tone="night" labelledby="titre-demarche">
    <Eyebrow class="m42-reveal">{approachSection.eyebrow}</Eyebrow>
    <div class="approach">
      <div class="approach-side m42-reveal">
        <h2 id="titre-demarche" class="h2">
          {approachSection.title}
        </h2>
        <ApproachSymbol />
      </div>
      <div class="approach-blocks">
        {approach.map((block) => (
          <div class="block m42-reveal">
            <h3 class="h3">{block.title}</h3>
            {block.paragraphs.map((p) => (
              <p class="body" set:html={p} />
            ))}
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Nos principes -->
  <Section id="principes" labelledby="titre-principes">
    <Eyebrow class="m42-reveal">{principlesSection.eyebrow}</Eyebrow>
    <h2 id="titre-principes" class="h2 h2--after-eyebrow m42-reveal">
      {principlesSection.title}
    </h2>
    <div class="principles">
      {principles.map((p, i) => (
        <div class="block m42-reveal">
          <span aria-hidden="true" class="num">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="h3">{p.title}</h3>
          <p class="body">{p.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Le duo : Clara puis Paul (Clara toujours en premier) -->
  <Section tone="sunk" label={duo.label}>
    <div class="duo">
      {intervenants.map((person) => (
        <IntervenantProfile person={person} labels={duo.labels} />
      ))}
    </div>
  </Section>

  <!-- Ce que nous ne faisons pas -->
  <Section id="limites" labelledby="titre-limites">
    <Eyebrow class="m42-reveal">
      <Fragment set:html={limitsSection.eyebrow} />
    </Eyebrow>
    <div class="limits-head m42-reveal">
      <h2 id="titre-limites" class="h2">
        {limitsSection.title}
      </h2>
      <p class="limits-lead" set:html={limitsSection.lead} />
    </div>
    <ul class="limits">
      {limits.map((l) => (
        <li class="limit m42-reveal">
          <h3 class="limit-title">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M5.6 5.6l12.8 12.8" />
            </svg>
            {l.title}
          </h3>
          <p class="body">{l.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Appel à l'action -->
  <AboutCta
    id="titre-contact"
    eyebrow={cta.eyebrow}
    title={cta.title}
    lead={cta.lead}
    links={cta.links}
    ctaLabel={cta.ctaLabel}
    ctaHref={cta.ctaHref}
    contacts={cta.contacts}
    phone={cta.phone}
  />
</BaseLayout>

<style>
  /* ---------- En-tête de page ---------- */
  section :global(.page-head) {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-7) var(--s-8);
  }

  .head-text {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    font-weight: 400;
  }

  .h1-main {
    max-width: var(--measure-h1);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tracking-h1);
    color: var(--ink);
  }

  .intro {
    margin: 0;
    max-width: var(--measure-lead);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--ink-2);
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .plus {
    color: var(--ink);
  }

  .head-photo {
    flex: 1 1 420px;
    min-width: 0;
  }

  /* Sur cette page */
  .toc {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .toc-label {
    color: var(--ink-3);
  }

  .toc-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .toc-link:hover {
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
  }

  /* ---------- Titres et textes communs ---------- */
  .h2 {
    margin: 0;
    max-width: var(--measure-h2);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--tracking-h2);
  }

  .h2--after-eyebrow {
    margin-top: var(--s-5);
  }

  .h3 {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  .body {
    margin: 0;
    max-width: var(--measure-text);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg-2);
    hyphens: auto;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-5);
  }

  /* ---------- Notre démarche ---------- */
  .approach {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-7) 80px;
  }

  .approach-side {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .approach-blocks {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ---------- Nos principes ---------- */
  .principles {
    margin-top: var(--s-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 40px var(--s-8);
  }

  .num {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--gold-deep);
  }

  /* ---------- Le duo ---------- */
  .duo {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 8vw, 7rem);
  }

  /* ---------- Ce que nous ne faisons pas ---------- */
  .limits-head {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5) var(--s-8);
  }

  .limits-lead {
    flex: 0 1 52ch;
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--ink-2);
  }

  .limits {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .limit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--s-2) var(--s-7);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .limit-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: var(--fs-faq);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: var(--tracking-h3);
  }

  .limit-title svg {
    flex: none;
    color: var(--ink);
  }
</style>
