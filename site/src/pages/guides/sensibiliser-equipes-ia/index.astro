---
/**
 * Satellite « guide » (kit/maquette/Sat-sensibiliser-equipes-ia.dc.html).
 * Contenus : src/data/satellites/sensibiliser-equipes-ia.ts (objet `page` : sections et blocs
 * typés, rendus ici selon leur `type`).
 * JSON-LD : Article (auteurs Person ×2, Clara puis Paul, via personSchema()) + WebPage
 * + BreadcrumbList + FAQPage (questions sans marqueur seulement, DECISIONS.md point 19).
 * `dateModified` absent tant que la date de mise à jour est « [À COMPLÉTER : date] ».
 * Aucun lien d'en-tête marqué dans la maquette : pas de `current`.
 * Pas de logique interactive (renderVals() vide) ; la FAQ est en <details> natif.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SatHero from '../../../components/satellites/SatHero.astro';
import SatBody from '../../../components/satellites/SatBody.astro';
import SatStep from '../../../components/satellites/SatStep.astro';
import SatSection from '../../../components/satellites/SatSection.astro';
import SatText from '../../../components/satellites/SatText.astro';
import SatBox from '../../../components/satellites/SatBox.astro';
import SatNote from '../../../components/satellites/SatNote.astro';
import SatTable from '../../../components/satellites/SatTable.astro';
import SatNumbered from '../../../components/satellites/SatNumbered.astro';
import SatMore from '../../../components/satellites/SatMore.astro';
import SatFaq from '../../../components/satellites/SatFaq.astro';
import SatLinkList from '../../../components/satellites/SatLinkList.astro';
import SatSources from '../../../components/satellites/SatSources.astro';
import SatCta from '../../../components/satellites/SatCta.astro';
import { satelliteArticleJsonLdOf } from '../../../data/satellites/json-ld';
import { page } from '../../../data/satellites/sensibiliser-equipes-ia';

const { seo, crumbs, hero, toc, sections, sources, cta } = page;
const { byline } = hero;
const dateModified = byline.dateModified ?? undefined;
const jsonLd = satelliteArticleJsonLdOf(page, dateModified);

const dateLabel = dateModified
  ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(
      new Date(`${dateModified}T00:00:00Z`),
    )
  : undefined;

// Étapes numérotées : numéro et total déduits de l'ordre des sections « step ».
const steps = sections.filter((s) => s.kind === 'step');
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <SatHero
    crumbs={crumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    lead={hero.lead}
    size="lg"
    measure="20ch"
  >
    <Fragment slot="byline">
      <span>
        {byline.by}{' '}
        <a href={byline.authors.href} class="sat-inline">
          {byline.authors.label}
        </a>
      </span>
      <span aria-hidden="true">·</span>
      <span>
        {byline.updated}{' '}
        {dateModified ? <time datetime={dateModified}>{dateLabel}</time> : byline.datePlaceholder}
      </span>
      <span aria-hidden="true">·</span>
      <span>{byline.readingTime}</span>
    </Fragment>
    <div slot="aside" role="note" aria-labelledby="bref-t" class="brief m42-night">
      <p id="bref-t" class="brief-label">
        {hero.brief.label}
      </p>
      <ol class="brief-list">
        {hero.brief.items.map((item, i) => (
          <li>
            <a href={item.href} class="brief-link">
              <span class="brief-num">{i + 1}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </SatHero>

  <SatBody toc={toc}>
    {sections.map((section, i) => {
      const blocks = section.blocks.map((block) => {
        switch (block.type) {
          case 'text':
            return (
              <SatText variant={block.variant}>
                {block.html !== undefined ? <Fragment set:html={block.html} /> : block.text}
              </SatText>
            );
          case 'box':
            return (
              <SatBox label={block.label}>
                {(block.paragraphs ?? []).map((p) => (
                  <SatText variant={p.variant}>
                    {p.html !== undefined ? <Fragment set:html={p.html} /> : p.text}
                  </SatText>
                ))}
                {block.list && (
                  <ol class="questionnaire">
                    {block.list.map((q) => (
                      <li>{q}</li>
                    ))}
                  </ol>
                )}
              </SatBox>
            );
          case 'note':
            return <SatNote label={block.label}>{block.text}</SatNote>;
          case 'table':
            return <SatTable table={block.table} />;
          case 'numbered':
            return <SatNumbered items={block.items} />;
          case 'more':
            return <SatMore href={block.href}>{block.label}</SatMore>;
          case 'sort':
            return (
              <figure class="sort">
                <div class="sort-grid">
                  {block.columns.map((col) => (
                    <div class:list={['sort-col', `sort-col--${col.level}`]}>
                      <p class="sort-label">{col.label}</p>
                      <span aria-hidden="true" class="sort-slot"></span>
                      <span aria-hidden="true" class="sort-slot"></span>
                    </div>
                  ))}
                </div>
                <figcaption>{block.caption}</figcaption>
              </figure>
            );
          case 'cards':
            return (
              <ul class="mistakes">
                {block.items.map((item) => (
                  <li>
                    <h3 class="mistake-title">{item.title}</h3>
                    <p class="mistake-text">{item.text}</p>
                  </li>
                ))}
              </ul>
            );
          case 'faq':
            return <SatFaq items={block.items} />;
          case 'links':
            return (
              <Fragment>
                <SatLinkList items={block.items} />
                {block.note && <p class="related-note">{block.note}</p>}
              </Fragment>
            );
          default:
            throw new Error(`Bloc non pris en charge sur cette page : ${block.type}`);
        }
      });
      return section.kind === 'step' ? (
        <SatStep
          id={section.id}
          n={steps.indexOf(section) + 1}
          total={steps.length}
          title={section.title}
          first={i === 0}
        >
          {blocks}
        </SatStep>
      ) : (
        <SatSection
          id={section.id}
          eyebrow={section.eyebrow ?? ''}
          title={section.title}
          first={i === 0}
        >
          {blocks}
        </SatSection>
      );
    })}

    <SatSources items={sources.items} notes={sources.notes ?? []} />
  </SatBody>

  <SatCta
    eyebrow={cta.eyebrow}
    title={cta.title}
    lead={cta.lead}
    note={cta.note}
    primary={cta.primary}
    secondary={cta.secondary}
  />
</BaseLayout>

<style>
  /* En bref (colonne droite de l'en-tête, fond nuit) */
  .brief {
    background: var(--night);
    color: var(--on-night);
    padding: 28px 28px var(--s-5);
  }

  .brief-label {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--on-night-3);
  }

  .brief-list {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .brief-list li {
    border-top: 1px solid var(--night-line);
  }

  .brief-link {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-3) 0;
    color: var(--on-night);
    text-decoration: none;
    font-size: 16px;
    line-height: 1.45;
  }

  .brief-num {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    line-height: 1;
    color: var(--gold-night);
  }

  /* Questionnaire prêt à l'emploi */
  .questionnaire {
    margin: var(--s-4) 0 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--ink);
  }

  /* Exercice de tri en trois colonnes */
  .sort {
    margin: var(--s-6) 0 0;
  }

  .sort-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: var(--s-3);
  }

  .sort-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px var(--s-4) 20px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-top: 3px solid var(--ink);
  }

  .sort-col--vert {
    border-top-color: var(--success);
  }

  .sort-col--orange {
    /* Pas de token « orange » dans la DA : valeur de la maquette */
    border-top-color: #8a5300;
  }

  .sort-label {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }

  .sort-slot {
    display: block;
    height: 28px;
    border: 1px dashed var(--line-strong);
  }

  .sort figcaption {
    margin-top: var(--s-3);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* Les quatre erreurs */
  .mistakes {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-4);
  }

  .mistakes li {
    padding: 22px 22px var(--s-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
  }

  .mistake-title {
    margin: 0;
    font-size: var(--fs-faq);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: var(--tracking-h3);
    color: var(--ink);
  }

  .mistake-text {
    margin: var(--s-2) 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .related-note {
    margin: var(--s-4) 0 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-3);
  }
</style>
