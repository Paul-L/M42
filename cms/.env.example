# Copier ce fichier en .env et remplacer chaque valeur « a-remplacer ».
# Ne jamais commiter le fichier .env.

# Base de données
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=a-remplacer

# Directus
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=a-remplacer
PUBLIC_URL=http://localhost:8055
DIRECTUS_PORT=8055
CORS_ORIGIN=http://localhost:4321

# Compte administrateur (créé au premier démarrage uniquement)
ADMIN_EMAIL=a-remplacer@m42.guide
ADMIN_PASSWORD=a-remplacer

# Licence Directus (Open Innovation Grant). Laisser vide pour la version de base.
LICENSE_KEY=
